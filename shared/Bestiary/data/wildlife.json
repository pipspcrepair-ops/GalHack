      "Lurker": { "behaviour": "Ambusher", "forms": { "stalker": 3, "skitterer": 2 }, "tells": ["Breath"], "tellSeconds": 1.4,
        "notice": 9, "strike": 5, "group": [1, 1], "healthScale": 1.6, "damageScale": 1.25, "sizeScale": 1.15, "hunts": true, "diet": "Prey" },
      "Prowler": { "behaviour": "Predator", "forms": { "stalker": 3, "strider": 1, "skitterer": 2 }, "tells": ["Growl", "Click"], "tellSeconds": 1.1,
