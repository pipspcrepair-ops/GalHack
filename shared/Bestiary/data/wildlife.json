      "Ambusher": { "behaviour": "Ambusher", "forms": { "creeper": 3, "ducteel": 3 }, "tells": ["Dust", "Shadow", "Rattle", "Thump", "Scratch"], "tellSeconds": 1.2,
        "notice": 10, "strike": 3.2, "group": [1, 1], "damageScale": 1.15 },
      "Nester": { "behaviour": "PackHunter", "forms": { "skitterer": 3, "creeper": 2 }, "tells": ["Hiss"], "tellSeconds": 1.2,
