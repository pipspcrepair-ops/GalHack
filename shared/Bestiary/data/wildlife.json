{
  // Tunables for the wildlife prototype. Shape: src/Core/WildlifeData.cs.
  // Weirdness runs 0 (an Earth animal) to 1 (nobody has a word for it). A planet's alienness
  // pulls its rolls towards forms, parts and patterns of matching weirdness.

  // Fairness comes from warning, not damage reduction: every creature's first attack on a
  // player is its behaviour's signature attack, telegraphed (wind-up per behaviour below), and
  // aimed where you stood when it committed, so stepping aside dodges it. Damage is never
  // capped. No creature is ranged yet.
  "combat": {
    "telegraphWindup": 1.1,
    "normalWindup": 0.45,
    "commitFraction": 0.65,
    "lungeSeconds": 0.25,
    "lungeReach": 1.2,
    "contactRadius": 1.0,
    "telegraphMemorySeconds": 20,
    "attackCooldown": 1.4,
    "playerMaxHealth": 100
  },

  "harvest": {
    "storageCapacity": 400,
    "treeHealth": 60,
    "bushHealth": 14,
    "woodPerTree": 24,
    "organicsPerTree": 6,
    "organicsPerBush": 8,
    "regrowSeconds": 45,
    "regrowBlockRadius": 70,
    "bladeDps": 110,
    "bladeCreatureDps": 160
  },

  "world": {
    "dayLengthSeconds": 360,
    "nightStart": 0.78,
    "nightEnd": 0.22
  },

  // Day and night. Each species is out in its cycle's hours (0 is midnight, 0.5 noon) and
  // rests at its rest site the rest of the day: dens against rocks and slopes, burrows in soft
  // ground, roosts on high ground, bedding grounds and hives near cover. Each creature's hours
  // shift by up to "stagger" of a day so a herd doesn't stand up at once, and a sleeper wakes
  // when a player comes within wakeRadius (scaled by how alarming they are: crouch to creep
  // past). Glowing species lean nocturnal. Underground and inside places there is no day:
  // their creatures are Cathemeral.
  "activity": {
    "windows": {
      "Diurnal": [[0.23, 0.77]],
      "Nocturnal": [[0.76, 1.0], [0.0, 0.24]],
      "Crepuscular": [[0.17, 0.33], [0.67, 0.83]]
    },
    "stagger": 0.015,
    "wakeRadius": 7,
    "wakeSeconds": 45,
    "restRadius": [12, 40],
    "glowNight": 2.5
  },

  // Where wildlife may appear. No creature spawns or respawns within baseClearance metres of
  // any base (a structure whose core is in base mode), measured from the structure's footprint
  // edge, so bigger bases get bigger zones. 80 m is past the longest perception any creature
  // rolls (about 67 m, a giant scavenger), so nothing new appears already close enough to
  // notice you at home. Only spawning is blocked: creatures may still wander in, and
  // capital-mode structures block nothing. Respawns also keep minPlayerDistance from every
  // player and out of the view cone of anyone within viewDistance.
  "spawning": {
    // The share of a species' natural groups a world holds at its most livable.
    "density": 0.5,
    "baseClearance": 80,
    "respawnSeconds": 90,
    "checkSeconds": 5,
    "minPlayerDistance": 90,
    "viewDistance": 220,
    "viewConeDegrees": 65,
    "stayPutRadius": 30,
    "stayPutSeconds": 60,
    "colonyClearance": 25,
    "caveClearance": 12,
    "attempts": 24
  },

  "fauna": {
    "speciesCount": [6, 10],
    "distinctPlans": 5,
    "surprise": [0.04, 0.35],
    "weirdnessFocus": 0.32,
    // Alien worlds may push proportions this far past a form's ranges (share of the range,
    // below and above). Kept small: further out, bodies read as broken rather than strange.
    "proportionPush": [0.15, 0.35],

