<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders drones to WAV with no engine, for listening and for the analysis script. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <RootNamespace>GalHack.Music.Render</RootNamespace>
    <AssemblyName>DroneRender</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" />
  </ItemGroup>
</Project>
