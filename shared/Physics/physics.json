// Every number the shared physics module uses. SI units throughout: metres, kilograms,
// seconds, newtons. Code defaults (GalHack.Physics.PhysicsRules) are the same numbers.
{
  "contacts": {
    // Damage = mass (t) × (closing speed − safe speed)² × damageScale. Never capped, never scaled
    // down; ramming uses the reduced mass m1·m2/(m1+m2) and both sides take it. The safe speed is
    // safeSpeed for everything but players, who land on their legs: playerSafeSpeed, so hops,
    // jetpack landings and falls up to about 12 m (15.5 m/s) never hurt them.
    "safeSpeed": 8,
    "playerSafeSpeed": 15.5,
    "damageScale": 0.001,
    // Kinematic hulls glance off fixed things with restitution × the closing speed, and lose
    // scrape × their sliding speed only on contacts that did damage.
    "restitution": 0.2,
    "scrape": 0.3,
    // Contacts slower than this raise no Impact event (resting, nudging), m/s.
    "eventSpeed": 2
  },

  "craters": {
    // Ground hits faster than speed (m/s) cut a real crater through the terrain's edit API:
    // radius = scale × ∛(kinetic energy in MJ), never more than maxRadius (terrain-digging's own
    // cap, which also limits a crater to 900 cells), none below minRadius. The blast sphere
    // sits lift × radius above the contact point, so it cuts a bowl.
    "speed": 25,
    "scale": 2,
    "maxRadius": 6,
    "minRadius": 1,
    "lift": 0.25
  },

  "integrity": {
    // How much damage a body takes to break, per tonne of it. The formula is the same for
    // everything; only toughness differs. Hull points are 4 per tonne (ship-handling's). A 100 kg
    // player at 0.6 per tonne, over their 15.5 m/s safe speed: a 20 m fall costs 3% of their
    // health, 30 m 13%, 50 m 42%, and about 80 m kills.
    "hullPerTonne": 4,
    "cratePerTonne": 4,
    "playerPerTonne": 0.6,
    "creaturePerTonne": 0.5
  },

  "hover": {
    // The ride-height servo (from ship-handling): verticalGain (1/s) closes the height error,
    // limited to maxRise up and maxGrip down (m/s²); grip holds only within gripBand metres above
    // ride height, so jumps fly. Look-ahead probes reach speed × lookAheadTime ahead (clamped);
    // terrain ahead rising more than stepAllowance × ride height lifts the vessel early, never
    // more than maxLift × ride height. It tilts to the ground's attitude (the plane through what
    // its engines and look-ahead probes see), settling at levelRate (1/s). Ground rising more
    // steeply than maxSlope (°), as a grade across the vessel's own length (the rise from the
    // ground under it over the run to the ground ahead), is refused, and it slides off ground
    // that steep; a crater's lip or a dug pit's edge is climbed, a cliff is not. maxSlope also
    // limits the tilt. Probes reach probeDepth × ride height below the engines.
    "verticalGain": 8,
    "maxRise": 40,
    "maxGrip": 30,
    "gripBand": 0.8,
    "maxClimbRate": 14,
    "lookAheadTime": 0.45,
    "lookAheadMin": 2,
    "lookAheadMax": 14,
    "stepAllowance": 0.5,
    "maxLift": 1.5,
    "levelRate": 6,
    "maxSlope": 45,
    "jumpSpeed": 7,
    "jumpCooldown": 1.2,
    "probeDepth": 3
  },

  "gear": {
    // Gear comes out by itself below deployAltitude (m above ground) when slower than deploySpeed
    // (m/s), and goes in again past them plus hysteresis; there is no button. A craft attached by
    // its gear or resting on its hull, slower than landSpeed, with nobody touching the controls for
    // idleBeforeLanding (s), settles over settleTime (s) and stops simulating. Each telescoping leg
    // reaches its own ground, so it lands as it is on uneven or dug ground.
    "deployAltitude": 15,
    "deploySpeed": 20,
    "hysteresis": 5,
    "extendTime": 0.8,
    "landSpeed": 3,
    "idleBeforeLanding": 0.3,
    "settleTime": 0.5
  },

  "riding": {
    // A rider of a ship lives in its cabin world, inside it or out on its hull. Out on the hull
    // it lets go of the ship when it jumps, or once it has been out of contact for letGoAfter (s)
    // while more than letGoNear (m) off the hull, or is more than letGoDistance (m) off it, so bumps
    // and edges never drop anyone: walking off a block on a deck (a 1 m drop, 0.45 s) stays near the
    // deck all the way down. It can't rejoin the same ship for rejoinAfter (s).
    "letGoAfter": 0.4,
    "letGoNear": 0.5,
    "letGoDistance": 1.5,
    "rejoinAfter": 0.5,
    // Out on the hull, down is the gravity the rider is in, as inside: the ship's core gravity,
    // or the zone's when the core is off (none in space, where they float). Walls and undersides
    // can't be walked on; a lip up to a step tall (walking.stepHeight) is stepped over.
    // Mag boots are switched off. On (magBoots true), down would be the face under the feet
    // (followed at upFollow 1/s, pulling at magBootGravity m/s²), outside edges would be walked
    // round (the boots look edgeProbe m below the face for the next one) and, with insideCorners,
    // walls taller than a step climbed. The camera eases its roll at viewEase (1/s).
    "magBoots": false,
    "magBootGravity": 9.8,
    "insideCorners": false,
    "edgeProbe": 0.35,
    "upFollow": 20,
    "viewEase": 10
  },

  "walking": {
    // Anything up to stepHeight (m) tall is a step, for every walking body on terrain, a cabin
    // floor or an outer hull: walking into it steps up onto it, walking off a ledge that deep
    // steps down without leaving the floor. Taller is a wall.
    "stepHeight": 0.6
  },

  "water": {
    // Water is a volume you go into, not a surface. Buoyancy is the displaced water's weight:
    // density / a body's density (bodies, kg/m³ of water displaced) × its weight × the share of its
    // height under the surface, so a body lighter than water floats with that share under and a
    // heavier one sinks to the bed. Drag is ½ρ·(CdA × dragScale)·|v|·v plus damping (1/s), times
    // the share under, applied so it can only slow a body. A vessel holding itself up holds its
    // weight less its buoyancy, so it flies underwater (slowly, through heavy drag); one that can't
    // (no power, too heavy) sinks. Hover vessels ride the surface while their hover is powered.
    "density": 1000,
    "dragScale": 0.25,
    "damping": 3,
    "bodies": { "vessel": 1600, "wreck": 2200, "crate": 450, "player": 800, "creature": 1000 },
    // A walker swims once swimDepth of its height is under water, and wades again below wadeDepth.
    // Swimming: swimSpeed (swimSprintSpeed sprinting) m/s, reached at swimAccel m/s², strokes holding
    // against buoyancy and drag up to swimGrip m/s². Left alone, a swimmer floats up to the surface.
    "swimDepth": 0.7,
    "wadeDepth": 0.55,
    "swimSpeed": 2.1,
    "swimSprintSpeed": 3,
    "swimAccel": 6,
    "swimGrip": 30
  },

  "stuck": {
    // A body inside terrain or a structure's blocks for this many ticks in a row is moved to the
    // nearest open space, searching a 1 m grid up to searchRadius metres away.
    "ticksBeforeRescue": 2,
    "searchRadius": 14
  }
}
