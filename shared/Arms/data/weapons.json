      "feel": "launcher", "tracer": { "colour": "3d4a3a", "width": 0.04, "length": 0.0, "body": "ball" },
      "look": { "band": "mid", "calibre": 0.78, "barrel": 0.22, "body": 0.2, "stock": "skeleton", "mag": "none", "sight": "side", "accent": "4a5a3a" } },

    // ---- RK3: the anti-armour staple. Backblast, a slow rocket with smoke. ----
