      "feel": "shotgun", "tracer": { "colour": "ffd070", "width": 0.008, "length": 0.7, "body": "tracer" },
      "look": { "band": "mid", "calibre": 0.6, "barrel": 0.3, "body": 0.24, "stock": "solid", "mag": "tube", "sight": "post", "accent": "6a5a44" } },

    // ---- GL2: the explosive launcher. Gravity and bounce, a blast on hit. ----
    { "id": "break-launcher", "code": "GL2", "name": "Break Launcher",
