      "blast": { "radius": 4, "damage": 150, "blocks": 5 },
      "feel": "throw", "tracer": { "colour": "ff2a1a", "width": 0.06, "length": 0.0, "body": "puck" },
      "look": { "band": "mid", "calibre": 0.5, "barrel": 0, "body": 0.1, "stock": "none", "mag": "none", "sight": "none", "accent": "4a4f55" } },

