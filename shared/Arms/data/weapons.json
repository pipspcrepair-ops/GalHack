      "look": { "band": "mid", "calibre": 1.0, "barrel": 0.55, "body": 0.24, "stock": "none", "mag": "none", "sight": "side", "vents": 0, "fins": 0, "accent": "56603f" } },

    // ---- MN13: the mine. Thrown, sticks to what it lands on, arms, trips in its radius. ----
    { "id": "prox-mine", "code": "MN13", "name": "Prox Mine",
      "trigger": "semi", "delivery": "placed", "class": "exp",
      "damage": 0, "rpm": 60, "magazine": 1, "reload": 0.6, "speed": 9, "life": 30, "gravity": 1,
