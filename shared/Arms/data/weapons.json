      "feel": "arc", "tracer": { "colour": "b8d8ff", "width": 0.02, "length": 1.4, "body": "spark", "light": true },
      "look": { "band": "high", "calibre": 0.45, "barrel": 0.14, "body": 0.24, "stock": "none", "mag": "cell", "sight": "none", "emitter": "prongs", "vents": 2, "accent": "8ab8ff" } },

    // ---- LV2: the owner's hornets. Swarm: short-lived homing stings that wander. Biomass is meat. ----
    { "id": "hornet-hive", "code": "LV2", "name": "Hornet Hive",
      "trigger": "auto", "delivery": "swarm", "class": "kin", "tags": [ "bio" ],
