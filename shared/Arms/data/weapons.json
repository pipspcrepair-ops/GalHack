// GalHack's weapons as data (docs/weapon-ideas.md: section 2 for the parts, section 8 for these
// twelve). A weapon is a row that combines shared parts; there is no code for any one gun. The
// item, its recipe and its tech-tree node live with the items (prototypes/slice/data/items.json).
//
//   trigger    semi, auto, burst (burst = rounds), pump (pump = seconds of action after a shot),
//              charge, hold
//   delivery   bolt, pellets, lob, cone, arc, swarm, placed
//   class      kin, exp, en: the design's damage classes, for armour and resistance
//   tags       fire, bio, shock, gas, rad, force (fire, gas and rad go past a personal shield)
//   damage     per bolt, pellet, sting or cone tick. Never scaled down by range or target.
//   rpm, magazine, reload (seconds; reloadEach: one round per reload), speed (m/s: every shot
//   travels at a speed you can see), life (seconds), spread and spreadMoving (degrees), recoil
//   (degrees of camera kick), noise (metres creatures hear it), blocks (multiplier on blocks:
//   0 leaves them unharmed), gravity (share of the planet's: lobbed shots arc)
//   ammo       { item, perItem }: rounds one item gives (else the ammo item's own count). Ammo
//              comes from the player first, then the gun's origin, then the nearest container.
//   parts      charge, pierce, bounce, pellets, arc, stick, dot, homing, swarm, cone, placed,
//              plus blast and backblast. Each is optional; see shared/Arms/Core/WeaponDef.cs.
//   modes      fire modes or shell types: each lays its fields over the row. Q steps through them.
//   feel       the GunFeel row (muzzle flash and kick); tracer: colour, width, length, body, light
//   look       what the generated model is made of: band (low crude and welded, mid utilitarian,
//              high sleek with emitters, living grown), calibre 0..1, barrel and body lengths (m),
//              stock, mag (box, tube, cell, tank, sac), sight, emitter, vents, fins, accent colour.
//              Sounds come from the same parts: calibre, energy, organic or not.
{
  "schema": "galhack.weapons",
  "version": 1,
  "rules": {
    // Owner's decisions: self-harm on, friendly fire a server setting (off by default), effects
    // on a player last seconds and always end.
    "selfHarm": true,
    "friendlyFire": false,
    "playerEffectSeconds": 4,
    // A cube of voxel ground stands a little proud of the drawn surface: how far above and below a
    // voxel hit a shot looks for the drawn ground's collider (if one is there, the collider decides).
    "groundGraze": 1.5
  },
  "weapons": [
    // ---- SA2: the first crafted gun. Proves hand weapons, magazine and reload. ----
    { "id": "tack-pistol", "code": "SA2", "name": "Tack Pistol",
      "trigger": "semi", "delivery": "bolt", "class": "kin",
      "damage": 22, "rpm": 320, "magazine": 12, "reload": 1.2, "speed": 220, "life": 1.4,
      "spread": 0.35, "spreadMoving": 1.1, "recoil": 0.9, "noise": 35, "blocks": 1.0,
      "ammo": { "item": "pistol-rounds" },
      "feel": "pistol", "tracer": { "colour": "ffd98a", "width": 0.011, "length": 1.0, "body": "tracer" },
      "look": { "band": "low", "calibre": 0.3, "barrel": 0.11, "body": 0.15, "stock": "none", "mag": "box", "sight": "post", "accent": "6b4a2e" } },

    // ---- RF2: the yardstick. Fire modes. ----
    { "id": "line-rifle", "code": "RF2", "name": "Line Rifle",
      "trigger": "auto", "delivery": "bolt", "class": "kin",
      "damage": 26, "rpm": 600, "magazine": 30, "reload": 1.8, "speed": 300, "life": 1.5,
      "spread": 0.25, "spreadMoving": 1.4, "recoil": 0.6, "noise": 55, "blocks": 1.0,
      "ammo": { "item": "rifle-rounds" },
      "modes": [ { "name": "AUTO", "trigger": "auto" }, { "name": "BURST", "trigger": "burst", "burst": 3, "rpm": 780 }, { "name": "SINGLE", "trigger": "semi", "spread": 0.15 } ],
      "feel": "rifle", "tracer": { "colour": "ffe2a0", "width": 0.012, "length": 1.6, "body": "tracer" },
      "look": { "band": "mid", "calibre": 0.42, "barrel": 0.26, "body": 0.3, "stock": "solid", "mag": "box", "sight": "rail", "vents": 2, "accent": "5d6448" } },

    // ---- SG2: the staple. Pellets, and shell types as data. ----
    { "id": "pump-scattergun", "code": "SG2", "name": "Pump Scattergun",
      "trigger": "pump", "pump": 0.55, "delivery": "pellets", "class": "kin",
      "damage": 9, "rpm": 70, "magazine": 6, "reload": 0.45, "reloadEach": true, "speed": 200, "life": 0.5,
      "spread": 0.5, "spreadMoving": 1.5, "recoil": 3.2, "noise": 60, "blocks": 0.6,
