      "feel": "rail", "tracer": { "colour": "8fe6ff", "width": 0.016, "length": 2.4, "body": "slug", "light": true },
      "look": { "band": "high", "calibre": 0.38, "barrel": 0.42, "body": 0.3, "stock": "skeleton", "mag": "cell", "sight": "scope", "emitter": "rings", "vents": 3, "accent": "5ad8ff" } },

    // ---- LT3: the owner's lightning. Arc: a target search and a lightning look. ----
    { "id": "fork-gun", "code": "LT3", "name": "Fork Gun",
      "trigger": "semi", "delivery": "arc", "class": "en", "tags": [ "shock" ],
