// Every block, by building's block id (prototypes/building/data plus the parts in
// building-parts.json and building-materials.json), and the block family items made from it.
// Blocks are craftable items, as in Empyrion: a constructor makes a block item from its bill, the
// player carries it in stacks, placing a block in survival uses one, and taking it down gives it
// back. One item per block and grid (the small and large grids are separate families); an armour
// item places as any shape, so a slope and a cube share one item and one bill (design section 11).
//
//   items           defaults for every block item, per family and grid: stack size and craft
//                   seconds. An item's mass and volume are its bill's (a block is what it is made
//                   of); its rarity is its rarest input's; its constructor tier is the lowest
//                   that can make everything in its bill.
//   family          armour (placed in any shape), device (the default: one fixed shape), or deco
//   grids           which grids it exists on, when not both: ["large"]
//   item            per grid, an item that isn't the default (id, name, short, stack, uses): the
//                   cores. "was" lists ids it replaced, so old saves and test data still load.
//   stack, seconds  per grid, overriding the family's defaults; tier overrides the derived tier
//
//   small / large   the bill on each grid. Small-grid blocks for a first vessel stay on common
//                   materials, so a small vessel is an hour or two from the crash. The foothold
//                   base (large core, generator, fuel tank, small constructor, containers, steel)
//                   needs only what the carried survival constructor makes.
//   uniqueOnly      the block needs a unique find (salvage only, never mined): no ore path
//   ammo            weapons only: the ammo item the block fires, drawn from shared storage
//   assembly        seconds the blueprint factory spends fitting one block, per grid
//   unlock          its tech-tree node on each grid (the tree is built from these, there is no
//                   separate tree file): the character level it unlocks from, its cost in unlock
//                   points, the parent node it hangs under (an item id, or block@grid) and its tab
//                   (base, small, tools, weapons, deco, misc). The base tab is Base & Capital and the
//                   small tab is Small & Hover: bases and capital vessels share the large grid, small
//                   and hover vessels the small one, so each tab is one grid's blocks, one node a block.
//                   Each tab grows from its core, the Big Core on one and the Small Core on the other, and
//                   on the small tab the hover plate is the parent of the thruster.
//
// No block is limited to a mode: a core's mode changes what its blocks do, never which blocks it takes.
{
  "schema": "galhack.blocks",
  "version": 1,
  "assembly": { "small": 0.4, "large": 1.6 },
  "items": {
    "stack":   { "armour": { "small": 500, "large": 250 }, "device": { "small": 25, "large": 10 }, "deco": { "small": 20, "large": 10 } },
    "seconds": { "armour": { "small": 1, "large": 2 },     "device": { "small": 3, "large": 6 },   "deco": { "small": 2, "large": 4 } }
  },
  "blocks": {
    // ---- Armour (building materials.json) ----------------------------------------------------
    "steel":     { "family": "armour", "small": { "hull-plate": 1 },                                     "large": { "hull-plate": 8 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "small-core", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "big-core", "tab": "base" } } },
    "hardened":  { "family": "armour", "small": { "hull-plate": 1, "gravium-ingot": 1 },                 "large": { "hull-plate": 8, "gravium-ingot": 4 },
                   "unlock": { "small": { "level": 8, "cost": 2, "parent": "steel@small", "tab": "small" },
                               "large": { "level": 6, "cost": 2, "parent": "steel@large", "tab": "base" } } },
    "combat":    { "family": "armour", "small": { "hull-plate": 1, "gravium-ingot": 2, "ceramic": 1 },   "large": { "hull-plate": 8, "gravium-ingot": 8, "ceramic": 4 },
                   "unlock": { "small": { "level": 14, "cost": 3, "parent": "hardened@small", "tab": "small" },
                               "large": { "level": 12, "cost": 3, "parent": "hardened@large", "tab": "base" } } },
    "glass":     { "family": "armour", "small": { "glass": 1 },                                          "large": { "glass": 6 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "steel@small", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "steel@large", "tab": "base" } } },
    "concrete":  { "family": "armour", "small": { "concrete-mix": 1 },                                   "large": { "concrete-mix": 6 },
                   "unlock": { "small": { "level": 6, "cost": 1, "parent": "steel@small", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "big-core", "tab": "base" } } },
    "precursor": { "family": "armour", "uniqueOnly": true, "small": { "precursor-alloy": 1 },            "large": { "precursor-alloy": 6 },
                   "unlock": { "small": { "level": 20, "cost": 5, "parent": "combat@small", "tab": "small" },
                               "large": { "level": 20, "cost": 5, "parent": "combat@large", "tab": "base" } } },

    // ---- Components (building components.json) ------------------------------------------------
    // There are two cores. A core item founds a new structure where it is set down (Empyrion's way):
    // the Big Core runs a base or a capital vessel, the Small Core a small vessel or a hover vessel,
    // and the core's mode, switched on the CORE tab, is the only difference between the two.
    "core":      { "small": { "hull-plate": 4, "circuit-board": 2, "winding": 1 },   "large": { "hull-plate": 16, "winding": 4, "copper-wire": 12 },
                   "seconds": { "small": 10, "large": 12 },
                   "item": { "small": { "id": "small-core", "name": "Small Core", "short": "SM CORE", "stack": 4, "was": [ "vessel-core", "hover-core" ],
                                      "uses": "Set down on open ground: a new small craft. Its mode, Hover or Vessel, is on the CORE tab" },
                             "large": { "id": "big-core", "name": "Big Core", "short": "BIG CORE", "stack": 4, "was": [ "base-core", "capital-core" ],
                                      "uses": "Set down on open ground: a new base. Its mode, Base or Capital, is on the CORE tab" } },
                   "unlock": { "small": { "level": 1, "cost": 1, "tab": "small" },
                               "large": { "level": 1, "cost": 0, "tab": "base" } } },
    // The only block that gives control: every seat aboard is a command chair, and you build
    // whatever enclosure you like round it. It gives no air: that takes a sealed room, or the suit.
    "chair":     { "small": { "hull-plate": 2, "circuit-board": 2, "polymer": 1 }, "large": { "hull-plate": 8, "control-unit": 2, "polymer": 2 },
                   "unlock": { "small": { "level": 1, "cost": 0, "parent": "small-core", "tab": "small" },
                               "large": { "level": 7, "cost": 1, "parent": "thruster@large", "tab": "base" } } },
    "thruster":  { "small": { "hull-plate": 2, "nozzle": 1, "winding": 1 },         "large": { "hull-plate": 10, "thrust-assembly": 2 },
                   "unlock": { "small": { "level": 5, "cost": 1, "parent": "hover@small", "tab": "small" },
                               "large": { "level": 7, "cost": 3, "parent": "big-core", "tab": "base" } } },
    "generator": { "small": { "hull-plate": 2, "winding": 2, "circuit-board": 1 },  "large": { "hull-plate": 10, "winding": 8, "copper-wire": 8 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "small-core", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "big-core", "tab": "base" } } },
    "fueltank":  { "small": { "hull-plate": 3, "polymer": 1 },                      "large": { "hull-plate": 8, "polymer": 2 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "generator@small", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "generator@large", "tab": "base" } } },
    "container": { "small": { "hull-plate": 2 },                                     "large": { "hull-plate": 12 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "small-core", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "big-core", "tab": "base" } } },
    "door":      { "small": { "hull-plate": 2, "servo": 1 },                         "large": { "hull-plate": 8, "servo": 2 },
                   "unlock": { "small": { "level": 6, "cost": 1, "parent": "steel@small", "tab": "small" },
                               "large": { "level": 2, "cost": 1, "parent": "steel@large", "tab": "base" } } },
    "light":     { "small": { "glass": 1, "copper-wire": 2 },                        "large": { "glass": 2, "copper-wire": 4 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "generator@small", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "generator@large", "tab": "base" } } },
    "turret":    { "ammo": "shells-40mm",
                   "small": { "hull-plate": 3, "servo": 2, "circuit-board": 1, "gun-barrel": 1 }, "large": { "hull-plate": 16, "servo": 4, "control-unit": 1, "gun-barrel": 2 },
                   "unlock": { "small": { "level": 10, "cost": 2, "parent": "gatling@small", "tab": "weapons" },
                               "large": { "level": 8, "cost": 2, "tab": "weapons" } } },
    "cpuext":    { "small": { "circuit-board": 4, "copper-wire": 4 },               "large": { "circuit-board": 8, "logic-module": 4 },
                   "unlock": { "small": { "level": 7, "cost": 1, "parent": "generator@small", "tab": "small" },
                               "large": { "level": 4, "cost": 1, "parent": "generator@large", "tab": "base" } } },
    "ladder":    { "stack": { "small": 100, "large": 50 }, "small": { "iron-bar": 1 },                                       "large": { "iron-bar": 3 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "steel@small", "tab": "small" },
                               "large": { "level": 1, "cost": 0, "parent": "steel@large", "tab": "base" } } },

    // ---- Vessel parts (prototypes/physics-sandbox/data/vessel-parts.json) -----------------------
    "gyro":      { "small": { "hull-plate": 2, "servo": 1, "circuit-board": 1 },    "large": { "hull-plate": 8, "servo": 2, "magnet": 4, "control-unit": 1 },
                   "unlock": { "small": { "level": 5, "cost": 1, "parent": "chair@small", "tab": "small" },
                               "large": { "level": 7, "cost": 1, "parent": "thruster@large", "tab": "base" } } },
    "hover":     { "small": { "hull-plate": 2, "winding": 2, "circuit-board": 1 },  "large": { "hull-plate": 8, "power-unit": 1, "nozzle": 2 },
                   "unlock": { "small": { "level": 1, "cost": 1, "parent": "small-core", "tab": "small" },
                               "large": { "level": 10, "cost": 2, "parent": "hover@small", "tab": "small" } } },
    "gear":      { "small": { "hull-plate": 2, "servo": 1 },                         "large": { "hull-plate": 6, "servo": 2 },
                   "unlock": { "small": { "level": 5, "cost": 0, "parent": "small-core", "tab": "small" },
                               "large": { "level": 7, "cost": 0, "parent": "thruster@large", "tab": "base" } } },

    // ---- Production and weapons (building-parts.json) -----------------------------------------
    "portfab":   { "small": { "hull-plate": 6, "winding": 2, "copper-wire": 4 },    "large": { "hull-plate": 12, "winding": 4, "copper-wire": 8, "glass": 2 },
                   "unlock": { "small": { "level": 3, "cost": 2, "parent": "survival-constructor", "tab": "misc" },
                               "large": { "level": 3, "cost": 2, "parent": "survival-constructor", "tab": "misc" } } },
    "smallfab":  { "small": { "hull-plate": 6, "winding": 2, "copper-wire": 4 },    "large": { "hull-plate": 12, "winding": 4, "copper-wire": 8, "glass": 2 },
                   "unlock": { "small": { "level": 6, "cost": 2, "parent": "small-core", "tab": "small" },
                               "large": { "level": 2, "cost": 1, "parent": "big-core", "tab": "base" } } },
    "largefab":  { "small": { "hull-plate": 12, "servo": 4, "circuit-board": 6, "machine-frame": 2 }, "large": { "hull-plate": 24, "servo": 6, "circuit-board": 10, "machine-frame": 4, "power-unit": 2 },
                   "unlock": { "small": { "level": 10, "cost": 3, "parent": "smallfab@small", "tab": "small" },
                               "large": { "level": 8, "cost": 3, "parent": "smallfab@large", "tab": "base" } } },
    "advfab":    { "small": { "hull-plate": 16, "servo": 4, "logic-module": 4, "machine-frame": 3, "starsilver-bar": 2 }, "large": { "hull-plate": 30, "servo": 8, "logic-module": 8, "machine-frame": 6, "starsilver-bar": 4 },
                   "unlock": { "small": { "level": 16, "cost": 5, "parent": "largefab@small", "tab": "small" },
                               "large": { "level": 15, "cost": 5, "parent": "largefab@large", "tab": "base" } } },
    "decon":     { "small": { "hull-plate": 8, "servo": 2, "circuit-board": 2, "nozzle": 1 }, "large": { "hull-plate": 16, "servo": 4, "circuit-board": 4, "nozzle": 2 },
                   "unlock": { "small": { "level": 7, "cost": 2, "parent": "smallfab@small", "tab": "small" },
                               "large": { "level": 4, "cost": 2, "parent": "smallfab@large", "tab": "base" } } },
    "factory":   { "small": { "hull-plate": 20, "servo": 6, "control-unit": 2, "machine-frame": 4, "logic-module": 2 }, "large": { "hull-plate": 40, "servo": 10, "control-unit": 4, "machine-frame": 8, "logic-module": 4 },
                   "unlock": { "small": { "level": 12, "cost": 4, "parent": "largefab@small", "tab": "small" },
                               "large": { "level": 10, "cost": 4, "parent": "largefab@large", "tab": "base" } } },
    "gatling":   { "ammo": "belt-12mm",
                   "small": { "hull-plate": 2, "gun-barrel": 1, "servo": 1 },       "large": { "hull-plate": 8, "gun-barrel": 3, "servo": 2 },
                   "unlock": { "small": { "level": 6, "cost": 2, "tab": "weapons" },
                               "large": { "level": 9, "cost": 2, "parent": "turret@large", "tab": "weapons" } } },
    // Drives: data only so far (warp and jumps aren't built yet). A warp drive burns warp cells
    // from a warp cell tank, inside a system; a hyperdrive burns fold crystal from a fold crystal
    // tank, between stars, and goes on capital vessels only.
    "warpdrive": {
                   "small": { "hull-plate": 8, "warp-coil": 1, "control-unit": 1 },        "large": { "hull-plate": 30, "warp-coil": 2, "control-unit": 2, "power-unit": 2 },
                   "unlock": { "small": { "level": 12, "cost": 3, "parent": "chair@small", "tab": "small" },
                               "large": { "level": 12, "cost": 3, "parent": "thruster@large", "tab": "base" } } },
    "warptank":  { 
                   "small": { "hull-plate": 3, "polymer": 1 },                             "large": { "hull-plate": 10, "polymer": 2 },
                   "unlock": { "small": { "level": 12, "cost": 0, "parent": "warpdrive@small", "tab": "small" },
                               "large": { "level": 12, "cost": 0, "parent": "warpdrive@large", "tab": "base" } } },
    "hyperdrive1": { "grids": ["large"],
                   "large": { "hull-plate": 40, "warp-coil": 4, "field-emitter": 2, "fusion-core": 1 },
                   "unlock": { "large": { "level": 15, "cost": 5, "parent": "warpdrive@large", "tab": "base" } } },
    "hyperdrive2": { "grids": ["large"],
                   "large": { "hull-plate": 60, "warp-coil": 8, "field-emitter": 4, "fusion-core": 2 },
                   "unlock": { "large": { "level": 20, "cost": 6, "parent": "hyperdrive1@large", "tab": "base" } } },
    "foldtank":  { "grids": ["large"], 
                   "large": { "hull-plate": 12, "polymer": 3 },
                   "unlock": { "large": { "level": 15, "cost": 0, "parent": "hyperdrive1@large", "tab": "base" } } },
    "rocketpod": { "ammo": "rocket",
                   "small": { "hull-plate": 3, "circuit-board": 1, "servo": 1 },    "large": { "hull-plate": 10, "control-unit": 1, "servo": 2 },
                   "unlock": { "small": { "level": 9, "cost": 2, "parent": "gatling@small", "tab": "weapons" },
                               "large": { "level": 11, "cost": 3, "parent": "turret@large", "tab": "weapons" } } }
  }
}
