// Structure power (design section 13, owner 15 Nov): generators charge capacitors, and every device
// draws from the capacitors by what it is doing right now; idle draws nothing. Generators burn fuel
// from core storage (the cargo containers: there are no fuel tanks) to keep the capacitors charged,
// up to their output, so the burn follows the load. Empty capacitors and no fuel: everything stops.
//
//   fuelUnitMJ  the energy in one unit of generator fuel (items.json "fuel"), MJ. A unit is Empyrion's
//               kWh: an hour at 1 kW, and 1 kW is 0.0005 MW on components.json's scale, so 1.8 MJ.
//               Empyrion's fuel values and burn rates read straight across.
//   coreMJ      the capacitor built into every core, MJ: about a minute of the Skiff at full thrust,
//               hours of a few lights. It fills from the generators and is drawn on first.
//   draw        what makes a device of each function draw, as shares of its block's power (MW at full
//               load, components.json). The live measures: throttle (its share of the thrust in its
//               direction), turning (the gyros' share of their turn), hovering (plates holding the
//               craft up), lit (a light or spotlight switched on), working (a constructor with a run under way),
//               seated (a chair someone sits in), on (whenever the structure has power). Not wired yet
//               (phase 2, no such device in the slice): idle, tracking and firing (turrets and fixed
//               guns, whose ammo comes from core storage), up and recharging (shields), engaged
//               (drives). A function not listed draws nothing: cores, containers, doors, pads, ladders.
//   drives      the jump fuels, from core storage: the item each drive burns, and how many per AU
//               (warp drive, in a system) or per light year (hyperdrive, between stars)
//   shield      shields also burn dribbles of fold crystal from core storage while recharging, never
//               while up or off: crystal per hit point recharged (owner, 15 Nov)
{
  "schema": "galhack.power",
  "version": 1,
  "fuelUnitMJ": 1.8,
  "coreMJ": 30,
  "draw": {
    "thruster": { "throttle": 1 },
    "gyro": { "turning": 1 },
    "hover": { "hovering": 1 },
    "light": { "lit": 1 },
    "spotlight": { "lit": 1 },
    "constructor": { "working": 1 },
    "chair": { "seated": 1 },
    "forecast": { "on": 1 },
    "turret": { "idle": 0, "tracking": 0.3, "firing": 1 },
    "weapon": { "idle": 0, "firing": 1 },
    "shield": { "up": 0.1, "recharging": 1 },
    "warp-drive": { "engaged": 1 },
    "hyperdrive": { "engaged": 1 }
  },
  "drives": {
    "warp-drive": { "fuel": "warp-cell", "per": 1, "unit": "AU" },
    "hyperdrive": { "fuel": "fold-crystal", "per": 1, "unit": "LY" }
  },
  "shield": { "foldPerHp": 0.0002 }
}
