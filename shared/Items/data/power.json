// Structure power (design section 13, owner 15 Nov): generators charge capacitors, and every device
// draws from the capacitors by what it is doing right now; idle draws nothing. Generators burn fuel
// from core storage (the cargo containers: there are no fuel tanks) to keep the capacitors charged,
// up to their output, so the burn follows the load. Empty capacitors and no fuel: everything stops,
// the core's gravity with it.
//
//   fuelUnitMJ  the energy in one unit of generator fuel (items.json "fuel"), MJ. A unit is Empyrion's
//               kWh: an hour at 1 kW, and 1 kW is 0.0005 MW on components.json's scale, so 1.8 MJ.
//               Empyrion's fuel values and burn rates read straight across.
//   coreMJ      the capacitor built into every core, MJ: about a minute of the Skiff at full thrust,
//               hours of a few lights. It fills from the solar panels and generators and is drawn on first.
//   draw        what makes a device of each function draw, as shares of its block's power (MW at full
//               load, components.json). The live measures: throttle (its share of the thrust in its
//               direction), turning (the gyros' share of their turn), hovering (plates holding the
//               craft up), lit (a light or spotlight switched on), working (a constructor with a run under way),
//               seated (a chair someone sits in), on (whenever the structure has power), firing (a gun
//               for a cadence after each shot; its ammo comes from core storage), up and recharging (a
//               shield holding, or filling), engaged (a drive spooling). Idle and tracking are turrets',
//               which have no aim of their own in the slice yet. A function not listed draws nothing:
//               cores, containers, doors, pads, ladders.
//   drives      the jump fuels, from core storage: the item each drive burns, how many per AU (warp drive,
//               in a system) or per light year (fold drive, between stars), and the seconds it spools on
//               its block's power before it jumps. Shields must be down to jump. A drive with a reach jumps no
//               further than its best block's at a time (the fold drive's tiers: design, T1 about 30 LY, T2 60).
//   shield      a structure's shield takes hits before its hull. By block: its hit points and recharge per
//               second at full power. It refills cooldown seconds after the last hit, burning dribbles of
//               fold crystal from core storage only while it recharges (crystal per hit point, owner 15 Nov;
//               "recharging only is fine"). Switched off or unpowered, it is down. Empyrion's small shield
//               generator: 4,000 points, 500 a second, 15 s cooldown, 3.6 kW (0.36 idle).
//   solar       solar panels (function "solar", their power the most they give in full sun) charge the
//               capacitors before any fuel burns: their share is the sun's height (day, night and latitude)
//               times what the cloud lets through (1 - cloudCut x cover).
{
  "schema": "galhack.power",
  "version": 1,
  "fuelUnitMJ": 1.8,
  "coreMJ": 30,
  "draw": {
    "thruster": { "throttle": 1 },
    "gyro": { "turning": 1 },
    "hover": { "hovering": 1 },
    "light": { "lit": 1 },
    "spotlight": { "lit": 1 },
    "constructor": { "working": 1 },
    "chair": { "seated": 1 },
    "forecast": { "on": 1 },
    "life-support": { "on": 1 },
    "turret": { "idle": 0, "tracking": 0.3, "firing": 1 },
    "weapon": { "idle": 0, "firing": 1 },
    "shield": { "up": 0.1, "recharging": 1 },
    "warp-drive": { "engaged": 1 },
    "fold-drive": { "engaged": 1 }
  },
  "drives": {
    "warp-drive": { "fuel": "warp-cell", "per": 1, "unit": "AU", "spool": 6 },
    "fold-drive": { "fuel": "fold-crystal", "per": 1, "unit": "LY", "spool": 15, "reach": { "fold-drive-t1": 30, "fold-drive-t2": 60 } }
  },
  "shield": { "fuel": "fold-crystal", "foldPerHp": 0.0002, "cooldown": 15, "blocks": { "shield-generator": { "hp": 4000, "recharge": 500 } } },
  "solar": { "cloudCut": 0.75 }
}
