      "id": "void-leviathan", "name": "A void leviathan passing", "category": "leviathan",
      "weight": 0.12, "territory": "any", "hostile": true,
      "requires": ["nebula|kind:deep"], "danger": [3, 5],
      "behaviour": "pass", "speed": [16, 24], "duration": [150, 220],
      "spawnDistance": [3200, 5000],
      "cleanup": "despawn",
      "signal": { "kind": "lifesign", "label": "Something vast on long-range sensors" },
      "creatures": [ { "kind": "void-leviathan", "role": "leviathan", "count": [1, 1] } ]
    }
  ]
}
