// The encounter deck: every event the director can spawn, as data.
//
// weight        base weight before zone tags apply
// category      for per-category caps and cooldowns (see director.json)
// faction       the event's faction; "*" takes the two factions whose territories meet here
// territory     any: spawns anywhere, more often inside the faction's territory
//               inside: only inside the faction's territory
//               outside: only outside it
//               border: only where two factions' territories meet
// hostile       hostile events get the danger grade's share of the deck (director.json)
// requires      zone tags that must all be present; "a|b" means either. Every zone has the
//               tags kind:<kind>, region:<region>, star:<class>, danger:<n> and poi:<poi>
// excludes      zone tags that must all be absent
// danger        [min, max] danger grade
// anchor        a POI kind the event happens at (traders dock at "station")
// behaviour     pass, convoy, dogfight, dock, mine or drift: the scripted flight
// speed         [min, max] m/s
// duration      [min, max] seconds before the event winds down
// spawnDistance [min, max] metres from the player (never nearer than the director's minimum)
// cleanup       despawn: untouched ships leave and are removed once out of sight
//               keepWrecks: as despawn, but ships wrecked in the event stay as salvage records
//               wreckOnExpire: if nobody touches it in time it is lost and stays as a wreck
// wrecks        ships wrecked during the event: count [min, max], when [from, to] as a
//               fraction of the duration
// signal        a lead for the players in the zone: a fuzzy direction and distance
// ships         groups of crewed ships. hull "$fighter" is the faction's fighter hull.
//               perExtraPlayer adds ships for each player beyond the first.
// creatures     space fauna instead of ships: groups of a creature "kind", a form the wildlife
//               prototype builds (prototypes/wildlife/data/space_fauna.json), with its drops.
//               Creatures have no crew, no faction and no territory, count against the
//               creature budget, and also keep director.json's creatureBaseClearance outside
//               every player base. They shoal (drift as one group, through their anchor POI if
//               it has one), cling (already on their anchor derelict, which must lie at a spawn
//               distance and out of every player's sight), pass or drift.
//
// factions: display name, fighter hull, and "fights": false for factions that never attack.
// Those can't appear in a hostile card (the deck refuses to load) or as a side in a border clash.
{
  "factions": {
    "meridian":    { "name": "Meridian Combine", "fighter": "corvette" },
    "exchange":    { "name": "Ledger Exchange", "fighter": "trader", "fights": false },
    "reavers":     { "name": "Carrion Reavers", "fighter": "raider" },
    "kessari":     { "name": "Kessari", "fighter": "lancer" },
    "hollow":      { "name": "Hollow Bloom", "fighter": "bloom-hulk" },
    "vharn":       { "name": "Vharn Dominion", "fighter": "vharn-gunship" },
    "freeholders": { "name": "Freeholders", "fighter": "homestead-hauler", "fights": false }
  },
  "events": [
    {
      "id": "freighter-pass", "name": "Freighter passing through", "category": "traffic",
      "weight": 10, "faction": "exchange", "territory": "any", "hostile": false,
      "requires": ["kind:orbit|kind:moon|kind:system|kind:deep"],
      "behaviour": "pass", "speed": [55, 80], "duration": [70, 110],
      "cleanup": "despawn",
      "ships": [ { "role": "freighter", "hull": "freighter", "count": [1, 1], "crew": [4, 9] } ]
    },
    {
      "id": "convoy", "name": "Ledger Exchange convoy under Meridian escort", "category": "traffic",
      "weight": 6, "faction": "exchange", "territory": "any", "hostile": false,
      "requires": ["kind:orbit|kind:moon|kind:system"],
      "behaviour": "convoy", "speed": [38, 50], "duration": [90, 130],
      "cleanup": "despawn",
      "ships": [
        { "role": "hauler", "hull": "hauler", "count": [3, 4], "crew": [3, 6] },
        { "role": "escort", "hull": "corvette", "faction": "meridian", "count": [1, 2], "crew": [5, 8] }
      ]
    },
    {
      "id": "patrol-vs-reavers", "name": "Meridian patrol clashing with Carrion Reavers", "category": "combat",
      "weight": 6, "faction": "meridian", "territory": "inside", "hostile": true,
      "requires": ["kind:orbit|kind:moon|kind:system|kind:deep"], "danger": [1, 5],
      "behaviour": "dogfight", "speed": [80, 120], "duration": [70, 100],
      "cleanup": "keepWrecks",
      "wrecks": { "count": [1, 2], "when": [0.3, 0.85] },
      "signal": { "kind": "transmission", "label": "Meridian patrol: engaging raiders" },
      "ships": [
        { "role": "patrol", "hull": "corvette", "faction": "meridian", "side": "a", "count": [2, 3], "perExtraPlayer": 1, "crew": [5, 8] },
        { "role": "raider", "hull": "raider", "faction": "reavers", "side": "b", "count": [2, 4], "perExtraPlayer": 1, "crew": [3, 6] }
      ]
    },
    {
      "id": "reaver-pack", "name": "Reaver pack on the prowl", "category": "combat",
      "weight": 5, "faction": "reavers", "territory": "any", "hostile": true,
      "requires": ["kind:orbit|kind:moon|kind:system|kind:deep"], "danger": [1, 5],
      "behaviour": "pass", "speed": [90, 120], "duration": [50, 80],
      "cleanup": "despawn",
      "ships": [ { "role": "raider", "hull": "raider", "count": [2, 4], "perExtraPlayer": 1, "crew": [3, 6] } ]
    },
