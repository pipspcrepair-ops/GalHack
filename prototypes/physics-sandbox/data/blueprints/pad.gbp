# Field Pad: a concrete landing pad 20 m square in Base Mode, a hazard-striped rim and the core
# in its middle. A base never flies and nothing moves it; a vessel landed on it parks there, out of
# the wind.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Field Pad"
grid 1m
mode base
gravity on

paint pad base=5a5e66 grime=2
paint hazard base=f4a100 pattern=hazard grime=2

block -10..9 0 -10 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -10 0 -9 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -9..8 0 -9 concrete-plated paint=pad
block 9 0 -9 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -10 0 -8 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -9..8 0 -8 concrete-plated paint=pad
block 9 0 -8 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -10 0 -7 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -9..8 0 -7 concrete-plated paint=pad
block 9 0 -7 concrete-plated paint=pad,pad,hazard,pad,pad,pad
block -10 0 -6 concrete-plated paint=pad,pad,hazard,pad,pad,pad
