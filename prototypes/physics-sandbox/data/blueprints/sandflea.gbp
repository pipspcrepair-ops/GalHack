# Sand Flea II: a small-grid hover rover for the physics sandbox, written by hand.
#
# Small grid (0.5 m cells). x is starboard, y up, -z forward. Four hover pads under the corners
# hold it 1.5 m off the ground (ride height from the handling model's small hover engine).
# An open cockpit, a windscreen, a cargo deck behind; two main engines, a retro and a side jet
# each way. A gyro and a generator are built into the body.

schema galhack.blueprint
version 1
name "Sand Flea II"
grid small
mode capital
gravity on

paint body base=f4a100 grime=1
paint belly base=2b2d42 grime=2
paint band base=e85d04 grime=1
paint pin base=f4a100 accent=2b2d42 pattern=stripes grime=1
paint teal base=0a9396 grime=1
paint check base=ece3c8 accent=2b2d42 pattern=checker grime=1

# --- Skirt (y 0) with the core ------------------------------------------------------------
block -3..3 0 -5..-1 steel paint=belly
block -3..-1 0 0 steel paint=belly
block 0 0 0 core
block 1..3 0 0 steel paint=belly
block -3..3 0 1..5 steel paint=belly

# --- Hover pads under the corners ----------------------------------------------------------
block -2 -1 -4 hover
block 2 -1 -4 hover
block -2 -1 4 hover
block 2 -1 4 hover

# --- Body (y 1): yellow with an orange band, gyro and generator inside, a sloped nose -------
block -3..3 1 -5 steel slope paint=band
block -3 1 -4..5 steel paint=body -x=pin
block -2..2 1 -4..2 steel paint=body
block -2..-2 1 3 steel paint=body
block -1 1 3 generator
block 0 1 3 steel paint=body
block 1 1 3 gyro
block 2 1 3 steel paint=body
block -2..2 1 4..5 steel paint=body
block 3 1 -4..5 steel paint=body +x=pin

# --- Open cockpit: the seat, a raked windscreen, a cargo deck behind ------------------------
block 0 2 -1 cockpit
block -1..1 2 -3 glass slope
block -3..3 2 2..5 steel paint=teal +z=check

# --- Engines: two mains at the back, a retro under the nose, a side jet each way ------------
block -2 1 6 thruster
block 2 1 6 thruster
block 0 0 -6 thruster rot=+y+z
block 4 1 0 thruster rot=+y-x
block -4 1 0 thruster rot=+y+x
