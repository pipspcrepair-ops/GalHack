# Deck Barge: a flat iron work barge for walking on a hull. A deck 8 m wide and 16 m long, two
# blocks thick with square edges; amidships a superstructure 2 m square and 2 m tall, a lip 0.5 m
# tall down the starboard side and a stair of three 0.5 m steps to port; aft a deckhouse 4 m clear
# inside with a door, and a lip 0.5 m tall across its floor. A seat at the bow, the machinery in the
# deck, thrusters all round it, four pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Deck Barge"
grid 1m
mode capital
gravity on

paint hull base=c9ccd1 grime=1
paint deck base=4a4e57 grime=1
paint inner base=d8d2c2
paint hazard base=f4a100 pattern=hazard grime=2
paint yellow base=f4a100 grime=1

block -3 -1 -7 thruster-t1 rot=+y+z
block 2 -1 -7 thruster-t1 rot=+y+z
block -4 -1 -6 pad-t1
block -3..2 -1 -6 iron-plated paint=hull
