# Deck Tender: a capital ship with a flat iron deck 20 m wide and 32 m long for small vessels to
# land and park on; the pilot's command chair at the bow behind a windscreen; under the deck a keel
# with the generator, fuel, two gyros, eight lift jets and four pads; mains aft, retros forward, a
# side jet each way and down jets at the deck's corners. A vessel landed on its deck parks there and
# rides it.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Deck Tender"
grid 1m
mode capital
gravity on

paint hull base=c9ccd1 grime=1
paint keel base=2b2d42 grime=2
paint deck base=5a5e66 grime=2
paint hazard base=f4a100 pattern=hazard grime=2

block -3 -2 -10 pad-t4
block 2 -2 -10 pad-t4
block -3 -2 10 pad-t4
block 2 -2 10 pad-t4
block -1..0 -2 16 iron-plated paint=keel
block -1..0 -2 17 iron-plated paint=keel
block -1..0 -2 18 stairs rot=+y+z paint=hull
block -4 -1 -15 thruster-t3 rot=+y+z
block 3 -1 -15 thruster-t3 rot=+y+z
block -4..3 -1 -14 iron-plated paint=keel
block -4..3 -1 -13 iron-plated paint=keel
block -4 -1 -12 thruster-t3 rot=+z+y
block -3..2 -1 -12 iron-plated paint=keel
block 3 -1 -12 thruster-t3 rot=+z+y
block -4..3 -1 -11 iron-plated paint=keel
