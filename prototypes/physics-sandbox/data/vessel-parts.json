// Components the handling model needs that the building catalogue doesn't have yet: gyros,
// hover pads and landing legs. Same format as prototypes/building/data/components.json (stats
// for a large-grid block; each grid scales them). The sandbox appends these to the building
// catalogue when it loads it; nothing in prototypes/building changes.
//
// What they DO comes from the handling model's parts table (prototypes/ship-handling/data/
// handling.json, "parts"): gyro torque, hover lift and ride height, leg length, by grid size
// (small grid uses the "small" part, large grid the "large" one). Mass comes from here, like
// every other block, so the four numbers are always the build's own.
{
  "schema": "galhack.components",
  "version": 1,
  "components": [
    {
      "id": "gyro", "name": "Gyro", "function": "gyro",
      "hp": 500, "armor": 10, "resist": { "kinetic": 0.1, "explosive": 0.1, "energy": 0.1 },
      "mass": 8, "cpu": 1500, "power": -0.5, "color": "2b2d42", "glow": "6ff2e0",
      "attach": "all", "airtight": "all", "covers": "all",
      "cost": { "iron": 14, "copper": 6, "electronics": 6 }, "smallCost": { "iron": 3, "copper": 2 },
      "parts": [
        { "box": [-0.5, -0.5, -0.5, 0.5, 0.5, 0.5], "style": "dark" },
        { "cylinder": "y", "segments": 16, "box": [-0.505, -0.12, -0.505, 0.505, 0.12, 0.505], "style": "glow" }
      ]
    },
    {
      "id": "hover", "name": "Hover pad", "function": "hover",
      "hp": 450, "armor": 10, "resist": { "kinetic": 0.1, "explosive": 0.1, "energy": 0.1 },
      "mass": 6, "cpu": 1500, "power": -1, "color": "3a3f47", "glow": "5ee0e6",
      "attach": ["+y"], "airtight": ["+y"], "covers": ["+y"],
      "cost": { "iron": 16, "electronics": 6 }, "smallCost": { "iron": 3, "copper": 2 },
      "parts": [
        { "box": [-0.5, 0.1, -0.5, 0.5, 0.5, 0.5], "style": "body" },
        { "cylinder": "y", "segments": 16, "box": [-0.46, -0.4, -0.46, 0.46, 0.1, 0.46], "style": "dark" },
        { "cylinder": "y", "segments": 16, "box": [-0.34, -0.5, -0.34, 0.34, -0.4, 0.34], "style": "glow" }
      ]
    },
    {
      "id": "gear", "name": "Landing leg", "function": "gear",
      "hp": 400, "armor": 10, "resist": { "kinetic": 0.1, "explosive": 0.1, "energy": 0.1 },
      "mass": 4, "cpu": 400, "power": -0.02, "color": "3a3f47", "accent": "f4a100",
      "attach": ["+y"], "airtight": ["+y"], "covers": ["+y"],
      "cost": { "iron": 10 }, "smallCost": { "iron": 2 },
      "parts": [
        { "box": [-0.4, -0.5, -0.4, 0.4, 0.5, 0.4], "style": "dark" },
        { "box": [-0.42, -0.2, -0.42, 0.42, -0.05, 0.42], "style": "accent" }
      ]
    }
  ]
}
