# A wrecked small-grid engine pod for the salvage pad. Written with a core so the blueprint loads;
# the scene takes the core out, leaving an unowned wreck for the deconstructor to break down.

schema galhack.blueprint
version 1
name "Wrecked pod"
grid small
mode capital

paint burnt base=3a3f47 texture=plates grime=3
paint scorch base=8b5a3c grime=3

block -2..2 0 -2..2 steel paint=burnt
block 0 1 0 core
block -2 1 -2..2 steel paint=scorch
block 2 1 -2..2 steel paint=burnt
block -1..1 1 -2 steel paint=burnt
block -1..1 1 2 steel paint=scorch
block -1 1 -1..1 steel slope paint=burnt
block 1 1 1 generator
block -2..2 2 -2 steel slope paint=burnt
block 0 1 3 thruster
block 1 1 3 thruster
block 0 2 0 gyro
