# Gadfly: the reference starter small vessel, written by hand to price a first ship.
#
# Small grid (0.5 m cells). x is starboard, y up, -z forward. A one-seat shuttle 3.5 m wide and
# 6 m long: a glazed cabin over the cockpit, a rear bay with the generator, fuel tank, gyro and a
# small container, two main engines, retros, lift jets, side jets, a roof jet and three legs.
# Every block in it is built from common materials (iron, copper, silicon, carbon, ice, stone).

schema galhack.blueprint
version 1
name "Gadfly"
grid small
mode capital
gravity on

paint hull base=ece3c8 grime=1
paint belly base=2b2d42 grime=2
paint stripe base=ece3c8 accent=e85d04 pattern=stripes grime=1
paint red base=c1121f grime=1
paint teal base=0a9396 grime=1

# --- Deck (y 0) with the core under the rear bay -----------------------------------------
block -3..3 0 -5..1 steel paint=belly
block -3..-1 0 2 steel paint=belly
block 0 0 2 core
block 1..3 0 2 steel paint=belly
block -3..3 0 3..5 steel paint=belly
block -2..2 0 -6 steel slope paint=red

# --- Sides (x +-3, y 1..3) with a racing stripe ----------------------------------------------
block -3 1..3 -5..5 steel paint=hull -x=stripe
block 3 1..3 -5..5 steel paint=hull +x=stripe

# --- Nose: a dash, the windscreen and a raked glass brow ---------------------------------
block -2..2 1 -5 steel paint=red
block -2..2 2 -5 glass
block -2..2 3 -5 glass slope

# --- Cabin: the seat, a glass canopy, a steel roof over the bay -----------------------------
block 0 1 -3 cockpit
block -2..2 3 -4..-1 glass
block -2..2 3 0..5 steel paint=teal

# --- Rear bay: generator, fuel tank, gyro, container, a shelf with a light -----------------
block -2 1 4 generator
block -1 1 4 fueltank
block 1 1 4 gyro
block 2 1 4 container
block 0 1 4 steel paint=hull
block -2..2 2 4 steel paint=hull
block 0 2 3 light
block -2..2 1..2 5 steel paint=hull

# --- Engines: two mains, two retros, four lift jets, side jets, a roof jet ------------------
block -2 1 6 thruster
block 2 1 6 thruster
block -3 1 -6 thruster rot=+y+z
block 3 1 -6 thruster rot=+y+z
block -2 -1 -4 thruster rot=+z+y
block 2 -1 -4 thruster rot=+z+y
block -2 -1 4 thruster rot=+z+y
block 2 -1 4 thruster rot=+z+y
block 4 2 0 thruster rot=+y-x
block -4 2 0 thruster rot=+y+x
block 0 4 2 thruster rot=+z-y

# --- Landing legs -------------------------------------------------------------------------
block 0 -1 -4 gear
block -3 -1 3 gear
block 3 -1 3 gear
