# Workshop: the manufacturing prototype's base. A concrete hall 14 x 8 m and 4 m floor to
# ceiling, a double door up a step; along the back wall a generator, the fabricator, four lockers,
# the deconstructor, the blueprint factory and fuel; a command chair by the west wall. Two turrets on
# the roof, a gatling and a rocket pod out of the back wall, so the fabricator has three kinds of
# ammo to keep stocked.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Workshop"
grid 1m
mode base
gravity on

paint wall base=e9dfc4 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint band base=0a9396 grime=1
paint roof base=3a3f47 grime=2

block -8..7 0 -5 concrete-plated paint=wall
block -8 0 -4 concrete-plated paint=wall
block -7..6 0 -4 concrete-plated paint=wall,wall,deck,wall,wall,wall
