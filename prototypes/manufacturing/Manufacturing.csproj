<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Manufacturing</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Building's chunk mesher runs on every edit; let the JIT optimise, as building does. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- The item catalogue, production machines, deposit shapes and the adapter to building. -->
    <Compile Include="..\..\shared\Items\**\*.cs" />
    <!-- Building's structure core and its view, compiled from where they live. Never copied, never changed here. -->
    <Compile Include="..\building\src\Structures\**\*.cs" />
    <Compile Include="..\building\src\Presentation\**\*.cs" />
    <!-- diegetic-ui's in-world screen (the glass, look-and-click cursor, hot spots, redraw manager)
         and the theme it builds on, compiled from where they live, as the slice does. -->
    <Compile Include="..\diegetic-ui\src\Screens\**\*.cs" />
    <Compile Include="..\diegetic-ui\src\Theme\**\*.cs" />
    <Compile Include="..\diegetic-ui\src\Logic\FocusMachine.cs" />
    <Compile Include="..\diegetic-ui\src\Logic\Items.cs" />
  </ItemGroup>
</Project>
