# Lancer 07: building's example ship, on building's own parts. A sealed iron cabin 6 m wide,
# 3 m floor to ceiling and 8 m long, two command chairs behind the glazed nose, a door each side up
# a step; behind its back wall four lockers, two generators and their fuel; three mains, two retros,
# side jets, four lift jets, two down jets and a turret on the roof. It turns at the game's floor
# rate and rests on its keel: building has no gyros and no pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Lancer 07"
grid 1m
mode flight
gravity on

paint hull base=ece3c8 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint belly base=2b2d42 grime=2
paint stripe base=ece3c8 accent=e85d04 pattern=stripes grime=1
paint chev base=0a9396 accent=f4a100 pattern=chevrons grime=1
paint hazard base=f4a100 pattern=hazard grime=2

block -4..3 -1 -7 iron-plated paint=hull,hull,hull,belly,hull,hull
block -4 -1 -6 iron-plated paint=hull,hull,hull,belly,hull,hull
block -3..2 -1 -6 iron-plated paint=hull,hull,deck,belly,hull,hull
