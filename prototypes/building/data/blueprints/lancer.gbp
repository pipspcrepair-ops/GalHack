block 3 -1 -5 iron-plated paint=hull,hull,hull,belly,hull,hull
block -4 -1 -4 thruster-t1 rot=+z+y
block -3..2 -1 -4 iron-plated paint=hull,hull,deck,belly,hull,hull
block 3 -1 -4 thruster-t1 rot=+z+y
block -4 -1 -3 iron-plated paint=hull,hull,hull,belly,hull,hull
