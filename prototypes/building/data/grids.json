// The one block grid: every structure is built on 1 m cells, and every stat in materials.json and
// components.json is the block's own, so nothing is scaled at load.
//   storageCap      the most SU a structure's containers add up to
//   cargoMassPerSu  tonnes per storage unit of cargo, for the mass readout
{
  "schema": "galhack.grids",
  "version": 1,
  "grids": [
    { "id": "1m", "cellSize": 1.0, "storageCap": 320000 }
  ],
  "cargoMassPerSu": 0.001
}
