[sub_resource type="GDScript" id="quit"]
script/source = "extends Node
# Quits the run after 20 minutes of real time if the test itself never does.
func _process(_delta):
	if Time.get_ticks_msec() > 1200000:
		printerr(\"FAIL  the run passed its time limit\")
		get_tree().quit(1)
		set_process(false)
"

