<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Wildlife</RootNamespace>
    <!-- Procedural rigs are thousands of small vector operations a frame. Debug builds (what the
         editor and tools/godot.ps1 -Play run) switch the JIT optimiser off, which made the
         creature update about 30% slower in tests/WildlifeTest.tscn. Play-tests should feel
         like the real game. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bestiary: everything that moves, generated, built and run. This prototype is its showroom. -->
    <Compile Include="..\..\shared\Bestiary\**\*.cs" />
    <!-- The sky seam check every prototype with a sky of its own runs (tests/SkySeamTest). -->
    <Compile Include="..\..\shared\Sky\**\*.cs" />
    <!-- Terrain-digging's engine-free voxel store and mesher, used in place: cave crawlers live
         in real dug tunnels and generator caves (src/Bridges/VoxelSpace.cs, the showroom, tests). -->
    <Compile Include="..\terrain-digging\src\Terrain\**\*.cs" />
    <!-- The planet generator's pure core (and its colour tables), used in place: species are built
         for their home landforms (src/Core/LandformFauna.cs), and the tests and the home-landform
         screenshots stand creatures on real generated planets. -->
    <Compile Include="..\planet-generator\src\Gen\**\*.cs" />
    <Compile Include="..\planet-generator\src\Look\**\*.cs" />
  </ItemGroup>
</Project>
