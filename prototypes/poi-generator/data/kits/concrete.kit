# The old civilisation's concrete: bunkers, towers, control towers, barracks, prisons. Raw grey
# concrete, olive-drab bands, hazard yellow, sodium-orange lamps. A style kit only: the architect
# builds its rooms from data/rooms.txt and re-skins them with this palette.

kit concrete
name Old-world concrete
faction none
light ffc890

panels 12 4 0.3
facade 56544f 5e5c58 e0a800

palette
  #  cube     concrete  7a7874|74726e|807d78   wall    cast concrete
  %  cube     concrete  8e8b84|88857e          wall    inner partitions
  _  cube     concrete  4e4c48|54524d          floor
  =  cube     concrete  6a6864|646260          roof
  *  cube     lumen     ffc890                 light   sodium lamps
  w  pane     glass     8aa4a8                 window
  k  cube     concrete  5a6440                 decor   olive band
  t  cube     steel     e0a800|1e1e1e          decor   hazard stripe
  m  machine  steel     5a5e60|52565a          decor   machinery
  b  bunk     cloth     5a6448                 decor   army bunks
  /  ramp     concrete  5a5854                 floor
