# Kessari Clans: machine people. Graphite plinths carrying pale modular lattices, cyan nodes
# for things that are working and magenta for things that are not. They build tall.

kit kessari
name Kessari Clans
faction kessari
light 3df2e0

panels 10 4 0.15
facade 1e272b cfe3e0 cfe3e0

alien
rooms keep
finish ceramic wall out:precast in:precast

palette
  #  cube     alloy    2e3a3f|33414a   wall    graphite
  l  lattice  alloy    cfe3e0|bcd4d0   wall    pale lattice frames
  %  cube     ceramic  cfe3e0|c4dad6   wall    pale ceramic panels
  _  cube     alloy    252e33          floor
  =  cube     alloy    2a353b          roof
  *  cube     lumen    3df2e0          light   cyan nodes
  n  cube     lumen    ff3d7f          light   magenta status nodes
  w  pane     glass    7fe8e0          window
  o  pillar   alloy    cfe3e0          wall
  m  machine  alloy    3a4a52|425460   decor
  /  ramp     alloy    3a4a52          floor
  u  cube     alloy    252e33          floor

