# Precursor ruins: older than anyone. Monolithic black stone in stepped masses, interiors
# taller than they need to be, jade glyph lines that still glow, bronze that never rusted.

kit precursor
name Precursor Ruins
# Not a faction: nobody living built these. Their wardens come from the [precursor] roster.
faction none
light 6ff0d0

palette
  #  cube     basalt   1b1c24|1f2029|18191f  wall    black monolith
  %  cube     basalt   2b2c38|30313e         wall    paler courses
  _  cube     basalt   24252e                floor
  =  cube     basalt   1e1f27                roof
  g  cube     glyph    4fe8c0                light   black stone with a glyph inlaid, still glowing
  *  cube     crystal  8ff5dc                light   light-wells: they need no power
  b  cube     bronze   a8783a|b5843f         decor   bronze
  o  pillar   basalt   2b2c38                wall
  c  crystal  crystal  6ff5d5                decor   glyph crystals
  /  ramp     basalt   2b2c38                floor
  u  cube     basalt   1e1f27                floor

