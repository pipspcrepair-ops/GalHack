<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>PoiGenerator</RootNamespace>
    <!-- The generator runs while a player waits for a place to appear, so even editor and
         debug runs use an optimised build (about five times faster). -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <!-- The terrain stamp planet-surface seats places with: the tests check that it carves
         every underground room out of the ground and leaves solid walls around them. -->
    <Compile Include="..\..\shared\Terrain\TerrainStamp.cs" />
    <Compile Include="..\building\src\Structures\LightSettings.cs" />
    <!-- The decorations library (alien rooms are dressed from it) and the item catalogue it reads its pieces from. -->
    <Compile Include="..\..\shared\Items\Core\**\*.cs" />
    <Compile Include="..\..\shared\Deco\**\*.cs" />
  </ItemGroup>
</Project>
