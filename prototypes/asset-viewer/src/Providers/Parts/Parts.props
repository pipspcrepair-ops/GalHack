<Project>
  <!--
    The Blocks, Items, Deco, Signs and Vehicles providers. They show the game's own blocks, items,
    deco, signs and vessels, built by the game's own code, so they compile what the slice compiles
    (the same list as Slice.csproj, in place) plus the slice's own source.
  -->
  <ItemGroup>
    <Compile Include="$(SharedRoot)Geometry\**\*.cs" />
    <Compile Include="$(SharedRoot)Physics\**\*.cs" />
    <Compile Include="$(SharedRoot)Terrain\**\*.cs" />
    <Compile Include="$(SharedRoot)Galaxy\**\*.cs" />
    <Compile Include="$(SharedRoot)Music\Core\**\*.cs" />
    <Compile Include="$(SharedRoot)Items\Core\**\*.cs" />
    <Compile Include="$(SharedRoot)Items\Production\**\*.cs" />
    <Compile Include="$(SharedRoot)Items\Bridge\**\*.cs" />
    <Compile Include="$(SharedRoot)Items\Deposits\**\*.cs" />
    <Compile Include="$(SharedRoot)Arms\Core\**\*.cs" />
    <Compile Include="$(SharedRoot)Bestiary\**\*.cs" />
    <Compile Include="$(SharedRoot)Testing\**\*.cs" />
    <Compile Include="$(SharedRoot)Deco\**\*.cs" />
    <Compile Include="$(SharedRoot)Flora\**\*.cs" />

    <Compile Include="$(ProtoRoot)terrain-digging\src\Terrain\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-generator\src\Gen\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-generator\src\Look\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-generator\src\Surface\FloraMeshes.cs" />
    <Compile Include="$(ProtoRoot)weather\src\Model\**\*.cs" />
    <Compile Include="$(ProtoRoot)weather\src\Forces\**\*.cs" />
    <Compile Include="$(ProtoRoot)weather\src\Glue.cs" />
    <Compile Include="$(ProtoRoot)poi-generator\src\Gen\**\*.cs" />
    <Compile Include="$(ProtoRoot)ship-handling\src\Handling\**\*.cs" />
    <Compile Include="$(ProtoRoot)building\src\Structures\**\*.cs" />
    <Compile Include="$(ProtoRoot)capital-base\src\Core\CutFree.cs" />
    <Compile Include="$(ProtoRoot)capital-base\src\Core\CapitalRules.cs" />
    <Compile Include="$(ProtoRoot)capital-base\src\Core\Cargo.cs" />
    <Compile Include="$(ProtoRoot)capital-base\src\World\LiftOff.cs" />
    <Compile Include="$(ProtoRoot)survival-vitals\src\Model\**\*.cs" />
    <Compile Include="$(ProtoRoot)diegetic-ui\src\Logic\FocusMachine.cs" />
    <Compile Include="$(ProtoRoot)diegetic-ui\src\Logic\Items.cs" />
    <Compile Include="$(ProtoRoot)saves\src\Persistence\**\*.cs" />
    <Compile Include="$(ProtoRoot)physics-sandbox\src\Bridges\HandlingBridge.cs" />
    <Compile Include="$(ProtoRoot)physics-sandbox\src\Bridges\StructureBridge.cs" />
    <Compile Include="$(ProtoRoot)physics-sandbox\src\Bridges\WeatherBridge.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Terrain\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-generator\src\Shaders.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Sky\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\World\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiSiting.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiSiting.Plan.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiLayer.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiLayerDeco.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiLayer.Tiers.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiLayer.StandIn.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Poi\PoiLitFaces.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Infra\**\*.cs" />
    <Compile Include="$(ProtoRoot)poi-generator\src\View\MeshBuild.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\Fx\**\*.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\WeatherView\IWeatherScene.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\WeatherView\LightningFx.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\src\WeatherView\TornadoFx.cs" />
    <Compile Include="$(ProtoRoot)building\src\Presentation\ChunkMesher.cs" />
    <Compile Include="$(ProtoRoot)building\src\Presentation\BlockMaterials.cs" />
    <Compile Include="$(ProtoRoot)building\src\Presentation\DamageFx.cs" />
    <Compile Include="$(ProtoRoot)building\src\Presentation\GhostPreview.cs" />
    <Compile Include="$(ProtoRoot)diegetic-ui\src\Theme\**\*.cs" />
    <Compile Include="$(ProtoRoot)diegetic-ui\src\Screens\**\*.cs" />
    <Compile Include="$(ProtoRoot)building\src\Game\Sfx.cs" />
    <Compile Include="$(ProtoRoot)diegetic-ui\src\World\Sfx.cs" />
    <Compile Include="$(ProtoRoot)planet-surface\tests\FrameProbe.cs" />
    <Compile Include="$(ProtoRoot)building\tests\OcclusionCheck.cs" />

    <!-- The slice's own source (everything but its entry scene's boot). -->
    <Compile Include="$(ProtoRoot)slice\src\**\*.cs" />
  </ItemGroup>
</Project>
