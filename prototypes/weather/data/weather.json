      "windSpeed": 38, "gustiness": 0.45, "temperature": -5, "solar": 0.1,
      "creatureActivity": 0.1, "creatureHint": "Hunkered down",
      "moveSpeed": 0.8,
      "durationMin": 180, "durationMax": 300, "forecastLead": 180, "warningLead": 150
    },
    {
      "kind": "Tornado", "name": "Tornado storm", "severe": true,
      "warning": "Tornado storm: funnels can lift you and your vehicles. Watch the cloud base",
      "cloudCover": 1.0, "cloudDarkness": 0.75, "rain": 0.3, "visibility": 2500,
      "windSpeed": 16, "gustiness": 0.7, "temperature": -3, "solar": 0.2,
      "creatureActivity": 0.35, "creatureHint": "Agitated, scattering",
      "lightning": 3, "tornadoes": 1.2,
