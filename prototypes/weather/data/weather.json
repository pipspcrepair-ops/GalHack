{
  "$schema": "./weather.schema.json",
  "about": "Weather states, planet archetypes and hazard rules. Times are in game seconds (a monsoon's 'days' are compressed to minutes here). Each state's values are what the weather settles to; the model blends between them.",

  "transitions": {
    "naturalSeconds": 40,
    "minSeconds": 6,
    "maxRates": {
      "CloudCover": 0.08,
      "CloudDarkness": 0.08,
      "Rain": 0.1,
      "Snow": 0.1,
      "Dust": 0.1,
      "Embers": 0.1,
      "GroundFog": 0.1,
      "VisibilityLog": 0.18,
      "WindX": 3.0,
      "WindZ": 3.0,
      "Gustiness": 0.1,
      "Temperature": 3.0,
      "Solar": 0.08,
      "CreatureActivity": 0.1,
      "Lightning": 1.0,
      "Tornadoes": 0.1,
      "Debris": 1.0,
      "MoveSpeed": 0.05,
      "Exposure": 0.15
    }
  },

  "ground": {
    "wetRate": 0.04,
    "dryRate": 0.006,
    "snowRate": 0.015,
    "meltRate": 0.0008,
    "dustRate": 0.02,
    "dustClearRate": 0.004
  },

  "lightning": {
    "buildUpSeconds": 4.0,
    "radius": 70,
    "strikeOffset": 180,
    "damage": 45,
    "damageRadius": 7,
    "maxConcurrent": 2
  },

  "debris": {
    "fallSeconds": 3.2,
    "radius": 4,
    "strikeOffset": 70,
    "damage": 22,
    "maxConcurrent": 3
  },

  "tornado": {
    "formSeconds": 14,
    "lifetime": 80,
    "dissipateSeconds": 12,
    "speed": 8,
    "turnRate": 0.12,
    "spawnDistance": 320,
    "maxActive": 2,
    "coreRadius": 7,
    "captureRadius": 14,
    "influenceRadius": 90,
    "orbitRadius": 7,
    "orbitSpeed": 17,
    "inflowSpeed": 8,
    "liftSpeed": 11,
    "releaseHeight": 40,
    "maxCarrySeconds": 8,
    "flingSpeed": 11,
    "releaseImmunity": 5,
    "flingHealthFloor": 0.15,
    "liftMassLimit": 1500,
    "response": 3.5,
    "visualHeight": 170
  },

