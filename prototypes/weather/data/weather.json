  "archetypes": [
    {
      "id": "temperate", "name": "Temperate plains", "baseTemperature": 16,
      "weights": { "Clear": 3, "Clouds": 4, "Rain": 3, "Monsoon": 1, "Fog": 1, "Thunderstorm": 2, "Hurricane": 1, "Tornado": 1.5 }
    },
    {
      "id": "swamp", "name": "Swamp", "baseTemperature": 24,
      "weights": { "Clouds": 2, "Rain": 3, "Monsoon": 2, "Fog": 4, "Thunderstorm": 1 }
    },
    {
      "id": "ocean", "name": "Ocean world", "baseTemperature": 18,
      "weights": { "Clear": 1, "Clouds": 3, "Rain": 3, "Monsoon": 2, "Fog": 2, "Hurricane": 2 }
    },
    {
      "id": "ice", "name": "Ice world", "baseTemperature": -14,
      "weights": { "Clear": 2, "Clouds": 3, "Fog": 2, "Snow": 4, "Blizzard": 2 }
    },
    {
      "id": "arid", "name": "Arid world", "baseTemperature": 32,
      "weights": { "Clear": 4, "Clouds": 1, "DustStorm": 3, "Tornado": 1 }
