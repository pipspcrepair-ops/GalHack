# Prospector 3: a small-grid harvesting vessel with a drill, written by hand for the
# capital-base prototype. It digs ore and rock from the ground under its keel and, with
# auto-transmit on, sends what it digs straight to Home.
#
# Small grid (0.5 m cells). x is starboard, y up, -z forward. The core sits in the deck.
# A glazed cab at the front, a cargo body of eight containers behind it, a generator and a gyro
# in the body, main engines at the back, lift jets and three landing legs under the deck, and
# the drill column hanging under the nose.
#
# Livery after Chris Foss: saffron with a teal cargo body and chevrons, a red nose, hazard
# stripes on the engine block.

schema galhack.blueprint
version 1
name "Prospector 3"
grid small
mode capital
gravity on

paint body base=f2a516 grime=1
paint belly base=2b2d42 grime=2
paint teal base=0b7285 grime=1
paint red base=c92a2a grime=1
paint stripe base=f2a516 accent=212529 pattern=stripes grime=1
paint chev base=0b7285 accent=ede4cc pattern=chevrons grime=1
paint hazard base=f2a516 accent=212529 pattern=hazard grime=2
paint dark base=3a3f47 texture=plates grime=2

# --- Deck (y 0) with the core, a red nose -----------------------------------------------------
block -3..3 0 -8 steel slope paint=red
block -3..3 0 -7..-1 steel paint=belly
block -3..-1 0 0 steel paint=belly
block 0 0 0 core
block 1..3 0 0 steel paint=belly
block -3..3 0 1..6 steel paint=belly

# --- Cab (z -7..-2): low red dash, a raked windscreen, glass canopy -------------------------
block -2..2 1 -7 steel slope paint=red
block -3 1..2 -7..-1 steel paint=body -x=stripe
block 3 1..2 -7..-1 steel paint=body +x=stripe
block -3 3 -6..-1 steel slope rot=+y-x paint=body
block 3 3 -6..-1 steel slope rot=+y+x paint=body
block -2..2 2 -6 glass slope
block -2..2 3 -5..-2 glass
block -2..2 1..3 -1 steel paint=body
block 0 1 -4 cockpit

# --- Cargo body (z 0..5): eight containers, a generator and a gyro under a teal roof --------
block -3 1..2 0..5 steel paint=teal -x=chev
block 3 1..2 0..5 steel paint=teal +x=chev
block -2..-1 1 1..2 container
block 1..2 1 1..2 container
block -2..-1 2 1..2 container
block 1..2 2 1..2 container
block 0 1 1 generator
block 0 1 2 gyro
block -3..3 3 0..5 steel paint=teal
block -2..2 1..2 5 steel paint=teal

# --- Engine block (z 6): two main engines under hazard stripes, down jets on the roof -------
block -3..3 1 6 steel paint=hazard
block -3..3 2 6 steel paint=dark
block -2 1 7 thruster
block 2 1 7 thruster
block -2 4 4 thruster rot=+z-y
block 2 4 4 thruster rot=+z-y

# --- Retros at the nose, side jets on the flanks ---------------------------------------------
block -3 1 -8 thruster rot=+y+z
block 3 1 -8 thruster rot=+y+z
block -4 1 3 thruster rot=+y+x
block 4 1 3 thruster rot=+y-x

# --- Under the deck: four lift jets, three legs, the drill column under the nose ------------
block -2 -1 -4 thruster rot=+z+y
block 2 -1 -4 thruster rot=+z+y
block -2 -1 3 thruster rot=+z+y
block 2 -1 3 thruster rot=+z+y
block 0 -1 -6 gear
block -3 -1 5 gear
block 3 -1 5 gear
block 0 -1 -2 steel cylinder paint=dark
block 0 -2 -2 steel cylinder paint=hazard
