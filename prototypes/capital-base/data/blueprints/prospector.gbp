# Prospector 3: a small harvesting vessel that lives on Bastion's pad and digs the ground
# under its keel. An open cab behind a red nose and a glass brow, stepped into from the port step; a
# cargo body of eight lockers round the generator, gyro and fuel; two mains, two retros, side jets,
# two lift jets, a down jet and three pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Prospector 3"
grid 1m
mode capital
gravity on

paint saffron base=f4a100 grime=1
paint belly base=2b2d42 grime=2
paint deck base=4a4e57 grime=1
paint teal base=0a9396 accent=f4a100 pattern=chevrons grime=1
paint red base=c1121f grime=1
paint hazard base=f4a100 pattern=hazard grime=2

block -2..-1 -1 -5 iron-plated paint=belly
block 0 -1 -5 pad-t1
block 1..2 -1 -5 iron-plated paint=belly
block -2..-1 -1 -4 iron-plated paint=belly
block 1..2 -1 -4 iron-plated paint=belly
block -2 -1 -3 iron-plated paint=belly
block -1..1 -1 -3 iron-plated paint=belly,belly,deck,belly,belly,belly
block 2 -1 -3 iron-plated paint=belly
block -2 -1 -2 iron-plated paint=belly
block -1..1 -1 -2 iron-plated paint=belly,belly,deck,belly,belly,belly
block 2 -1 -2 iron-plated paint=belly
block -2 -1 -1 iron-plated paint=belly
block -1..1 -1 -1 iron-plated paint=belly,belly,deck,belly,belly,belly
block 2 -1 -1 iron-plated paint=belly
block -3 -1 0 stairs rot=+y-x paint=saffron
block -2..1 -1 0 iron-plated paint=belly,belly,deck,belly,belly,belly
block 2 -1 0 iron-plated paint=belly
block -2..0 -1 1 iron-plated paint=belly
block 1 -1 1 core
block 2 -1 1 iron-plated paint=belly
block -2 -1 2 iron-plated paint=belly
block -1 -1 2 thruster-t1 rot=+z+y
block 0 -1 2 iron-plated paint=belly
block 1 -1 2 thruster-t1 rot=+z+y
block 2 -1 2 iron-plated paint=belly
block -2 -1 3 pad-t1
block -1..1 -1 3 iron-plated paint=belly
block 2 -1 3 pad-t1
block -1..1 -1 4 iron-plated paint=belly
block -2..2 0 -5 iron-plated slope paint=red
block -3 0 -4 thruster-t1 rot=+y+z
block -2..2 0 -4 iron-plated paint=red
block 3 0 -4 thruster-t1 rot=+y+z
block -2 0 -3 iron-plated paint=saffron
block 0 0 -3 command-chair
block 2 0 -3 iron-plated paint=saffron
block -2 0 -2 iron-plated paint=saffron
block 2 0 -2 iron-plated paint=saffron
block -2 0 -1 iron-plated paint=saffron
block 2 0 -1 iron-plated paint=saffron
block 2 0 0 iron-plated paint=saffron
block -2..2 0 1 iron-plated paint=teal
block -2 0 2 iron-plated paint=teal
block -1 0 2 generator-t1
block 0 0 2 gyro-t1
block 1 0 2 fuel-tank-t1
block 2 0 2 iron-plated paint=teal
block -3 0 3 thruster-t1 rot=+y+x
block -2..2 0 3 iron-plated paint=teal
block 3 0 3 thruster-t1 rot=+y-x
block -2..2 0 4 iron-plated paint=teal,teal,teal,teal,hazard,teal
block -1 0 5 thruster-t1
block 1 0 5 thruster-t1
block -2..2 1 -4 glass-plated slope
block -2 1 1 iron-plated paint=teal
block -1 1 1 container-t1
block 0 1 1 iron-plated paint=teal
block 1 1 1 container-t1
block 2 1 1 iron-plated paint=teal
block -2 1 2 iron-plated paint=teal
block -1 1 2 container-t1
block 0 1 2 iron-plated paint=teal
block 1 1 2 container-t1
block 2 1 2 iron-plated paint=teal
block -2 1 3 iron-plated paint=teal
block -1 1 3 container-t1
block 0 1 3 iron-plated paint=teal
block 1 1 3 container-t1
block 2 1 3 iron-plated paint=teal
block -2 1 4 iron-plated paint=teal,teal,teal,teal,hazard,teal
block -1 1 4 container-t1
block 0 1 4 iron-plated paint=teal,teal,teal,teal,hazard,teal
block 1 1 4 container-t1
block 2 1 4 iron-plated paint=teal,teal,teal,teal,hazard,teal
block 0 2 2 thruster-t1 rot=+z-y
