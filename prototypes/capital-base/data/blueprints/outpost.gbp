# Outpost 2: a small blockhouse base, written by hand for the capital-base prototype. It is a
# second place a player can flag as Home. Its concrete footing goes a block into the ground.
#
# Large grid (2 m cells). x is starboard, y up, -z forward. The core sits in the floor.
# Livery after Chris Foss: concrete walls with a saffron band, a hazard-striped door frame, a
# big stencilled 2, a red roof cap and a teal beacon mast.

schema galhack.blueprint
version 1
name "Outpost 2"
grid large
mode base
gravity on

paint wall base=b9b2a4 grime=2
paint band base=b9b2a4 accent=f2a516 pattern=stripes grime=2
paint hazard base=f2a516 accent=212529 pattern=hazard grime=2
paint red base=c92a2a grime=1
paint teal base=0b7285 grime=1
paint n2 base=f2a516 accent=212529 stencil=2 grime=1

# --- Footing (y -1) and floor (y 0) with the core ---------------------------------------------
block -2..2 -1 -2..2 concrete paint=wall
block -2..2 0 -2..-1 concrete paint=wall
block -2..-1 0 0 concrete paint=wall
block 0 0 0 core
block 1..2 0 0 concrete paint=wall
block -2..2 0 1..2 concrete paint=wall

# --- Walls (y 1..2), a door to the south, the number to the east -----------------------------
block -2 1..2 -2..2 concrete paint=wall -x=band
block 2 1 -2..2 concrete paint=wall +x=band
block 2 2 -2..-1 concrete paint=wall
block 2 2 0 concrete paint=wall +x=n2
block 2 2 1..2 concrete paint=wall
block -1..1 1..2 -2 concrete paint=wall -z=band
block -1 1..2 2 concrete paint=hazard
block 0 1 2 door rot=+y+z
block 0 2 2 concrete paint=hazard
block 1 1..2 2 concrete paint=hazard

# --- Inside: storage and power ----------------------------------------------------------------
block -1 1 -1 container
block 1 1 -1 generator
block 0 2 -1 light rot=+z-y

# --- Roof (y 3) and a beacon mast ---------------------------------------------------------------
block -2..2 3 -2..2 concrete paint=red
block 0 4 0 steel cylinder paint=teal
block 0 5 0 steel cylinder paint=hazard
