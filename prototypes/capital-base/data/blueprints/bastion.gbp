# Bastion 7: a capital ship that lands on a planet, becomes a base and lifts off again. Two
# iron rooms 10 m wide and 4 m floor to ceiling: the bridge forward, two command chairs behind the
# glazed nose, and the engineering hall aft with seven Container T4s, two generators, their fuel and
# two gyros; a double door between them and one at the stern up a step. The hall's roof is a landing
# pad 12 x 14 m for a small vessel. Nacelles on the flanks; Thruster T3s; six pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Bastion 7"
grid 1m
mode capital
gravity on

paint hull base=e9dfc4 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint saffron base=f4a100 grime=1
paint red base=c1121f grime=1
paint hazard base=f4a100 pattern=hazard grime=2
paint chev base=0a9396 accent=e9dfc4 pattern=chevrons grime=1
paint pad base=5a5e66 grime=2

block -6..5 0 -13 iron-plated paint=hull,hull,hull,hull,hull,red
block -6 0 -12 pad-t3
