// Invasion tunables: the warning timeline, where invaders come from, how big the force is and what it rides in.
// Message templates can use {attacker} {source} {bearing} {compass} {minutes} {tier} {troops} {vehicles} {base}.
{
  "attacker": "Vharn Dominion",

  // Warnings counted back from the moment the force arrives. The largest lead is when the invasion is
  // announced, so the first warning always fires the instant an invasion is scheduled.
  "timeline": {
    "warnings": [
      {
        "level": 1, "secondsBeforeArrival": 600, "longRangeScan": false, "siren": false,
        "message": "{attacker} assault force inbound from {source}. Approach bearing {bearing} {compass}. Arrival in {minutes} minutes."
      },
      {
        "level": 2, "secondsBeforeArrival": 300, "longRangeScan": true, "siren": false,
        "message": "{attacker} force on long-range scan: {tier}, {troops} troops in {vehicles}. Arrival in {minutes} minutes."
      },
      {
        "level": 3, "secondsBeforeArrival": 60, "longRangeScan": true, "siren": true,
        "message": "{attacker} assault one minute out from {compass}. Sirens sounding. Man the defences."
      }
    ]
  },

  "presence": {
    // An invasion only runs while a player is in the base's zone. If everyone leaves for this long,
    // an incoming invasion is called off and an assault in progress withdraws.
    "abandonGraceSeconds": 60
  },

  "sources": {
    // Vharn bases within this distance of a player base send its invasions; the nearest one is chosen.
    "nearbyRange": 1500,
    // Ship raids have further to come, so they arrive less often than raids from a nearby base.
    "shipRaidIntervalMultiplier": 1.5,
    // Where a ship raid shows up on long-range scans at the second warning.
    "shipScanDistance": 6000,
    "shipNames": [ "the carrier Ishka Vol", "the cruiser Morrow Kesh", "the assault ship Thane Oruk", "the troopship Vel Hadra" ]
  },

  // What each kind of source can field. Vehicle weights pick the mix of carriers.
  "sourceKinds": {
    "outpost":  { "label": "outpost",  "forceMultiplier": 0.8, "maxTroops": 16,  "vehicles": { "apc": 1 } },
    "garrison": { "label": "garrison", "forceMultiplier": 1.0, "maxTroops": 48,  "vehicles": { "apc": 2, "dropship": 1 } },
    "fortress": { "label": "fortress", "forceMultiplier": 1.3, "maxTroops": 160, "vehicles": { "apc": 1, "dropship": 1 } },
    "ship":     { "label": "ship",     "forceMultiplier": 0.9, "maxTroops": 64,  "vehicles": { "dropship": 1 } }
  },

  // troops = (baseTroops + troopsPerPoint * threat) * playerMultiplier * source forceMultiplier,
  // clamped to [minTroops, min(maxTroops, source maxTroops)], where
  // threat = storedValue / storedValuePerPoint + blocks / blocksPerPoint + turrets * pointsPerTurret.
  "scaling": {
    "storedValuePerPoint": 400,
    "blocksPerPoint": 20,
    "pointsPerTurret": 2,
    "baseTroops": 4,
    "troopsPerPoint": 0.45,
    // Indexed by players present: 1, 2, 3, 4. Each player past the list adds extraPlayerMultiplier.
    "playerMultipliers": [ 1.0, 1.45, 1.85, 2.2 ],
    "extraPlayerMultiplier": 0.3,
    "minTroops": 4,
    "maxTroops": 160
  },

  // Names for the size of the force, by troop count. A small outpost faces a squad; a fortress faces an army.
  "tiers": [
    { "name": "squad",     "minTroops": 0 },
    { "name": "platoon",   "minTroops": 12 },
    { "name": "company",   "minTroops": 30 },
    { "name": "battalion", "minTroops": 60 },
    { "name": "army",      "minTroops": 100 }
  ],

  // Crewed carriers. Every vehicle has a driver or pilot plus a gunner per gun; guns name weapons in fire_control.json.
  "vehicles": {
    "apc":      { "label": "APC",      "capacity": 6, "guns": [ "autocannon", "rocket_pod" ],     "flies": false, "speed": 17 },
    "dropship": { "label": "dropship", "capacity": 8, "guns": [ "door_minigun", "door_minigun" ], "flies": true,  "speed": 42 }
  },

  // Share of each troop role. Breachers carry charges that open walls and doors quickly.
  "troopRoles": { "rifleman": 0.6, "breacher": 0.25, "heavy": 0.15 },
  "minBreachersPerVehicle": 1,

  "approach": {
    // Vehicles come into sight this far out, drive or fly in and set troops down at the drop distance.
    "deployDistance": 650,
    "dropDistance": 210,
    "vehicleSpacing": 28,
    "maxStaggerSeconds": 4,
    // A withdrawing invader this far from the base is gone.
    "goneDistance": 520
  },

  // Placeholder breach planner: a wall with this many hit points is worth one extra cell of walking around.
  "planner": { "hpPerCellOfDetour": 30 },

  "messages": {
    "victory": "Assault repelled. All {attacker} invaders are down or gone.",
    "coreDestroyed": "Core destroyed. {base} is offline. {attacker} troops are withdrawing.",
    "withdrawn": "The last {attacker} invader has withdrawn.",
    "calledOff": "{attacker} assault from {source} called off.",
    "abandoned": "No one is home: the {attacker} assault on {base} is called off.",
    "abandonedWithdraw": "No one is home: the {attacker} invaders are withdrawing from {base}.",
    "sourceDestroyed": "{source} destroyed. It sends no more invasions.",
    "sourceHijacked": "{source} hijacked. It sends no more invasions.",
    "stopped": "No {attacker} base in range of {base} and ship raids are off: invasions have stopped.",
    "resumed": "{attacker} forces are in range of {base} again.",
    "offline": "{base} is offline: no power, turrets down. Place a new core.",
    "online": "New core online. {base} is powered again."
  }
}
