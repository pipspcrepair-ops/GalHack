// The player base in this prototype: a block grid on open ground, its storage and its starting goods.
// Layout rows run north (top) to south; one character is one 2 m cell.
//   W wall   D door   C storage container   G generator   K core   T turret   S console screen   . floor
{
  "name": "Homestead",
  "cellSize": 2.0,
  "wallHeight": 3.0,
  // Ground around the layout that the planner covers (cells), so invaders plan their way through the
  // clutter of the approach, not just the walls. Beyond it they walk straight with local avoidance.
  "margin": 40,
  // Players within this many metres of the base centre are "in its zone" for the presence rule.
  "zoneRadius": 300,

  "layout": [
    "WWWWWWWWWWWWWWWWWT",
    "W................W",
    "W.CC..........G..W",
    "W.....WWWDWW.....W",
    "W.....W....W..S..W",
    "W.....W....W.....W",
    "W.....W..K.W.....W",
    "W.....W....W.....W",
    "W.....WWWWWW.....W",
    "W................W",
    "W.CC.........S...W",
    "W................W",
    "TWWWWWWWDWWWWWWWWW"
  ],

  "legend": {
    "W": { "kind": "wall",      "hp": 600 },
    "D": { "kind": "door",      "hp": 300 },
    "C": { "kind": "container", "hp": 350, "capacity": 220 },
    "G": { "kind": "generator", "hp": 500 },
    "K": { "kind": "core",      "hp": 2500 },
    "T": { "kind": "turret",    "hp": 700 },
    "S": { "kind": "console",   "hp": 250 }
  },

  // Layout cells [column, row] for the siren beacons, the interior lights and where the player starts.
  "sirens": [ [1, 1], [16, 1], [1, 11], [16, 11] ],
  "lights": [ [3, 5], [14, 7], [8, 10], [3, 10], [14, 10], [9, 5], [9, 1] ],
  "playerSpawn": [ 8, 10 ],

  "items": {
    "iron_plate":   { "name": "Iron plate",   "value": 2 },
    "copper_wire":  { "name": "Copper wire",  "value": 3 },
    "polymer":      { "name": "Polymer",      "value": 4 },
    "food_ration":  { "name": "Food ration",  "value": 6 },
    "rifle_ammo":   { "name": "Rifle ammo",   "value": 1 },
    "power_cell":   { "name": "Power cell",   "value": 25 },
    "medkit":       { "name": "Medkit",       "value": 40 },
    "rare_crystal": { "name": "Rare crystal", "value": 250 }
  },

  "startingInventory": {
    "iron_plate": 180,
    "copper_wire": 90,
    "polymer": 60,
    "food_ration": 40,
    "rifle_ammo": 300,
    "power_cell": 24,
    "medkit": 12,
    "rare_crystal": 6
  }
}
