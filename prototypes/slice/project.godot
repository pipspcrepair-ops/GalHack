; Engine configuration file.
; Edit it in the Godot editor or by hand.

config_version=5

[application]

config/name="GalHack: Slice"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="Slice"

[physics]

common/physics_interpolation=true
common/max_physics_steps_per_frame=3
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.005
jolt_physics_3d/simulation/speculative_contact_distance=0.05

[rendering]

limits/global_shader_variables/buffer_size=524288

renderer/rendering_method="mobile"
occlusion_culling/use_occlusion_culling=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

planet_size={
"type": "vec2",
"value": Vector2(16000, 8000)
}
weather_wind={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
weather_ground={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
weather_flash={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
