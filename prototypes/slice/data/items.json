    { "id": "line-rifle", "name": "Line Rifle", "short": "LINE", "category": "weapon", "rarity": "common", "mass": 3.6, "volume": 4,
      "uses": "Auto · burst · single", "unlock": { "level": 7, "cost": 2, "tab": "weapons" } },
