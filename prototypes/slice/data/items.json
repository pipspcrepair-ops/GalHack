  "recipes": [
    // Free, always: you wake empty-handed and make it first. Once made it is never dropped on death.
    { "make": "survival-tool", "count": 1, "from": {}, "free": true,                                     "seconds": 3,  "tier": -1 },
    // The handheld scanner is free too: it pings what is far off, and the compass marks it for a while.
    { "make": "scanner",       "count": 1, "from": {}, "free": true,                                     "seconds": 2,  "tier": -1 },
    // The core scanner is a handheld scanner with refined parts, made in the survival constructor.
    { "make": "core-scanner",  "count": 1, "from": { "scanner": 1, "circuit-board": 2, "winding": 2 },      "seconds": 14, "tier": 0 },
    // The hover bike is basic metals and silicon, made in the suit fabricator: getting about is quick from early on.
    { "make": "hover-bike",    "count": 1, "from": { "iron-ore": 30, "copper-ore": 12, "silicon-ore": 8 }, "seconds": 20, "tier": -1 },
    // The better tools are made from refined parts, in the survival and portable constructors.
    { "make": "mining-drill",  "count": 1, "from": { "iron-bar": 8, "copper-wire": 6, "circuit-board": 1 }, "seconds": 16, "tier": 0 },
    { "make": "plasma-drill",  "count": 1, "from": { "mining-drill": 1, "hull-plate": 4, "circuit-board": 3, "winding": 2 }, "seconds": 24, "tier": 1 },
    { "make": "trail-ration",  "count": 1, "from": { "biomass": 2 },                                     "seconds": 3,  "tier": -1 },
    { "make": "patch-kit",     "count": 1, "from": { "biomass": 2, "silicon-ore": 1 },                   "seconds": 4,  "tier": -1 },
    { "make": "air-cell",      "count": 1, "from": { "biomass": 3 },                                     "seconds": 4,  "tier": -1 },
    // Weapons: low-tech in the survival constructor, mid in the small and portable ones, high in the large.
    { "make": "tack-pistol",      "count": 1, "from": { "iron-bar": 6, "copper-wire": 2 },                         "seconds": 8,  "tier": 0 },
    { "make": "pressure-thrower", "count": 1, "from": { "hull-plate": 4, "iron-bar": 4, "copper-wire": 4, "polymer": 2 }, "seconds": 14, "tier": 1 },
    { "make": "pump-scattergun",  "count": 1, "from": { "gun-barrel": 1, "iron-bar": 6, "polymer": 2 },            "seconds": 12, "tier": 1 },
    { "make": "line-rifle",       "count": 1, "from": { "gun-barrel": 1, "iron-bar": 8, "circuit-board": 1, "polymer": 2 }, "seconds": 14, "tier": 1 },
    { "make": "break-launcher",   "count": 1, "from": { "gun-barrel": 1, "hull-plate": 4, "circuit-board": 1 },     "seconds": 14, "tier": 1 },
    { "make": "shoulder-tube",    "count": 1, "from": { "hull-plate": 6, "circuit-board": 2, "gun-barrel": 1 },     "seconds": 16, "tier": 1 },
    { "make": "prox-mine",        "count": 1, "from": { "explosive-charge": 1, "circuit-board": 1, "hull-plate": 1 }, "seconds": 5, "tier": 1 },
    { "make": "hornet-hive",      "count": 1, "from": { "hide": 6, "rare-tissue": 2, "polymer": 2 },              "seconds": 16, "tier": 1 },
    { "make": "stage-rifle",      "count": 1, "from": { "gun-barrel": 2, "magnet": 4, "circuit-board": 3, "hull-plate": 3 }, "seconds": 24, "tier": 2 },
    { "make": "wormspitter",      "count": 1, "from": { "hide": 8, "rare-tissue": 3, "polymer": 3 },              "seconds": 20, "tier": 2 },
    { "make": "fork-gun",         "count": 1, "from": { "winding": 4, "magnet": 2, "circuit-board": 3, "hull-plate": 2 }, "seconds": 24, "tier": 2 },
    { "make": "bend-rounds",      "count": 1, "from": { "gun-barrel": 1, "logic-module": 2, "circuit-board": 2, "hull-plate": 2 }, "seconds": 24, "tier": 2 },
    // Their ammo: one box a run, as every ammo recipe.
    { "make": "rifle-rounds",      "count": 1, "from": { "iron-bar": 1, "propellant": 2 },                       "seconds": 3, "tier": 0 },
    { "make": "buck-shells",       "count": 1, "from": { "iron-bar": 1, "propellant": 1 },                       "seconds": 2, "tier": 0 },
    { "make": "slug-shells",       "count": 1, "from": { "iron-bar": 2, "propellant": 1 },                       "seconds": 2, "tier": 0 },
    { "make": "launcher-grenades", "count": 1, "from": { "explosive-charge": 1, "iron-bar": 1 },                 "seconds": 4, "tier": 1 },
    { "make": "rail-slugs",        "count": 1, "from": { "iron-bar": 3, "graphite": 1 },                         "seconds": 4, "tier": 2 },
    { "make": "smart-rounds",      "count": 1, "from": { "iron-bar": 1, "propellant": 1, "circuit-board": 1 },   "seconds": 4, "tier": 1 }
  ],
  "replaceRecipes": [
    { "make": "survival-constructor", "count": 1, "from": { "iron-ore": 16, "copper-ore": 8, "silicon-ore": 4 }, "seconds": 20, "tier": -1 }
  ],
  "constructors": [
    { "id": "suit", "name": "Suit fabricator", "tag": "FAB-S", "tier": -1, "speed": 2.0 }
  ],
  "consumables": {
    "trail-ration": { "food": 0.3 },
    "meat":         { "food": 0.12 },
    "patch-kit":    { "health": 25 },
    "medkit":       { "health": 60 },
    "air-cell":     { "oxygen": 250 },
    "o2-bottle":    { "oxygen": 75 }
  }
}
