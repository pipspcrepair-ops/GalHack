    // nothing and opens with it: unlocking a weapon unlocks its ammo. Living weapons eat plain biomass.
    { "id": "tack-pistol", "name": "Tack Pistol", "short": "TACK", "category": "weapon", "rarity": "common", "mass": 1.1, "volume": 1.5,
