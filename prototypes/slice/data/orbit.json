// The slice's orbit (phase 2): the start world seen as a globe, the climb out and the descent,
// the start system's wrecks near the world, and boarding them. Read by src/Orbit/OrbitRules.cs.
// Everything else (the map, its colours, the places in space) is read from the prototype that owns it.
{
  "globe": {
    // The globe's radius against the map: the map's width is the length of its equator, so 1 is
    // true scale (radius = width / 2π, about 2.5 km for a 16 km world).
    "radiusScale": 1.0,
    // How high the rim of air drawn round the globe reaches, as a share of its radius. It thins
    // away to nothing by there, and has to stay under the orbit's lowest height.
    "atmosphere": 0.15,
    // The sheet's polar grid: bearings and rings, spread closest under you.
    "segments": 256,
    "rings": 160,
    // The colour map's width in pixels (planet-generator's ColorMap; half as tall) and the clouds'.
    "textureWidth": 2048,
    "cloudWidth": 1024,
    // Clouds sit this share of the radius over the ground, at this share of the generator's
    // cover (its cloud map is a stormy day's; thinned, the land under it reads from orbit).
    "cloudHeight": 0.012,
    // The share of the map's relief the true globe draws (it is a small world: at full height its
    // peaks would stand a quarter of its radius high). All of it at the cap, thinning up the climb.
    "reliefFar": 0.12,
    // How far round the globe the sheet shows the sphere's map, degrees from the point under you.
    // Past it (only low down, where the sheet is far wider than the globe) it is the flat map.
    "sphereReach": 105,
    // How many days' worth of sun a trip round the map's equator is. 1 is the true globe: the same
    // sun in the sky from the ground and from space. Under 1 softens the time zones on the surface,
    // and the sun then jumps at the crossing by what was softened away.
    "mapDaysPerTurn": 1.0,
    // A temperate world's year, game days: every orbit's period follows from it, so this one number
    // is how fast the system runs. Short enough that planets can be seen to move in play.
    "temperateYearDays": 24,
    // The globe is painted once, from the sky's clouds as they stand, but a clear spell under you
    // shouldn't leave the whole world bare: its share of cloud is at least this.
    "cloudCoverAtLeast": 0.38,
    "cloudOpacity": 0.55
  },

  // Crossing between the surface and orbit is seamless: no loading, position, heading and velocity
  // carried straight across. What you see is set from your height alone, the same both ways: the
  // air thickens to the cap in the world's own colours, the land hands over to the globe's sheet
  // behind it, and it thins away to black space with the world curving away below.
  "crossing": {
    // The cap, m: orbit starts here on every world, low, on Empyrion's scale, just over the clouds
    // (their tops are about 1,000 m). The design keeps the land under it (peaks to about 900 m).
    // Nothing stands in the atmosphere over it.
    "altitude": { "default": 1060 },
    // Orbit starts being made once a climb passes this share of the cap, so it is ready long before.
    "preloadAt": 0.2,
    // The gap between the two edges, m: a climb crosses at the cap and a descent this far
    // under it, so a crossing never bounces straight back.
    "gap": 80,
    // The air fades away with height from here (m): the sky darkens into space's own backdrop and
    // the wind dies away, over this and the band.
    "fadeFrom": 700,
    // The band, m over the cap: the surface's sky turning into space's, the star's light taking over.
    // The land is already gone: at its foot the sheet is all the ground there is.
    "band": 1000,
    // The shroud: the air round you, from this height up to the cap (m), holding a little over it
    // and thinning away over this many metres. Its thickness is this share at the most, times the
    // share the world's air allows.
    "shroudFrom": 760,
    "shroudHolds": 30,
    "shroudThins": 620,
    "shroudThickness": 0.9,
    // The swap, m: the sheet comes over the land from here up to the cap, behind the shroud.
    "swapFrom": 960,
    // The sheet's curve: its radius (m) up to the cap, nearly flat, tightening with height to the
    // true globe at this height, m. The map wraps from the flat map onto the sphere over this many
    // metres above the cap.
    "flatCurve": 300000,
    "trueGlobeAt": 7000,
    "mapWrapsBy": 2400,
    // A descent starts streaming the ground under it this many bands over the cap.
    "streamAhead": 1.5
  },

  "wrecks": {
    // The POI generator's start-system sites (poi-generator/data/orbit.txt, OrbitPlacement) are
    // placed by its bearing and its distance, brought in close: its "near" band (200 to 2,000 km
    // from the world) maps to these metres above the crossing, and its "orbit" band (1,000 to
    // 30,000 km) to the next, all clear of the band. Moon, belt and deep sites belong to
    // other zones.
    "near": [ 1300, 2600 ],
    "orbit": [ 2600, 5400 ],
    // Sites keep within this latitude of the globe's equator, degrees.
    "maxLatitude": 55,
    // What the survival tool's gather mode gets back from a wreck's block (design: about 33 %),
    // and how long it takes to cut one free, seconds per tonne (a light block a second or two).
    "salvageReturn": 0.33,
    "salvageSecondsPerTonne": 0.6,
    "salvageMinSeconds": 1.2,
    "salvageReach": 4.0,
    // A wreck's hold, by its salvage grade: item, least, most (each container block holds one roll).
    "loot": {
      "scrap":    [ [ "iron-bar", 2, 8 ], [ "hull-plate", 1, 4 ], [ "copper-wire", 1, 5 ], [ "air-cell", 0, 2 ], [ "polymer", 0, 3 ] ],
      "salvage":  [ [ "hull-plate", 2, 6 ], [ "circuit-board", 1, 3 ], [ "servo", 0, 2 ], [ "air-cell", 1, 3 ], [ "trail-ration", 0, 2 ], [ "patch-kit", 0, 2 ], [ "energy-cell", 0, 2 ] ],
      "military": [ [ "hull-plate", 2, 6 ], [ "gun-barrel", 0, 2 ], [ "control-unit", 0, 1 ], [ "explosive-charge", 0, 2 ], [ "air-cell", 1, 2 ], [ "patch-kit", 1, 2 ] ],
      "rare":     [ [ "circuit-board", 1, 4 ], [ "logic-module", 0, 2 ], [ "field-emitter", 0, 1 ], [ "fold-crystal", 0, 1 ], [ "air-cell", 1, 2 ] ]
    }
  },

  "space": {
    // How far the camera sees in orbit, m (the moons stand far off).
    "cameraFar": 60000,
    "moonDistance": 40000,
    // Ambient light out of the sun: space is dark, and so is a dead hull's inside.
    "ambient": [ 0.035, 0.038, 0.055 ],
    "sunEnergy": 1.6,
    // The suit outside: no air at all (the helmet seals and the suit's own oxygen runs down), and
    // what a sealed suit feels, °C: in vacuum it loses heat slowly, so a cool day, not a deep
    // freeze. And space's background radiation, RAD (the visor warns above 3).
    "vacuumC": 4,
    "radiation": 0.4
  }
}
