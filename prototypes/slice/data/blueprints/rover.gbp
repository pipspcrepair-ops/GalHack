# Hover Rover: a low, wide ground runner on four hover plates, built of painted base blocks.
# An open cockpit behind a raked windscreen, stepped into from the port step; the engine bay behind
# with the generator, gyro, fuel and a locker; two mains in the tail and a retro either side of the dash.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Hover Rover"
grid 1m
mode hover
gravity on

paint body base=f4a100 grime=1
paint belly base=2b2d42 grime=2
paint deck base=4a4e57 grime=1
paint stripe base=f4a100 pattern=stripes grime=1
paint hazard base=f4a100 pattern=hazard grime=2

block -2 -1 -4 base-block slope rot=-x-z paint=belly
block -1..1 -1 -4 base-block paint=belly
block 2 -1 -4 base-block slope rot=+x-z paint=belly
block -2..2 -1 -3 base-block paint=belly
block -2 -1 -2 hover-t1
block -1..1 -1 -2 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 -2 hover-t1
block -2 -1 -1 base-block paint=belly
block -1..1 -1 -1 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 -1 base-block paint=belly
block -3 -1 0 stairs rot=+y-x paint=body
block -2..1 -1 0 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 0 base-block paint=belly
block -2..-1 -1 1 base-block paint=belly
block 0 -1 1 core
block 1..2 -1 1 base-block paint=belly
block -2 -1 2 hover-t1
block -1..1 -1 2 base-block paint=belly
block 2 -1 2 hover-t1
block -2..2 -1 3 base-block paint=belly
block -2 0 -4 base-block slope rot=-x-z paint=body
block -1..1 0 -4 base-block slope paint=body
block 2 0 -4 base-block slope rot=+x-z paint=body
block -3 0 -3 thruster-t1 rot=+y+z
block -2..2 0 -3 base-block paint=hazard
block 3 0 -3 thruster-t1 rot=+y+z
block -2 0 -2 base-block paint=stripe
block 0 0 -2 command-chair
block 2 0 -2 base-block paint=stripe
block -2 0 -1 base-block paint=stripe
block 2 0 -1 base-block paint=stripe
block 2 0 0 base-block paint=stripe
block -2..2 0 1 base-block paint=body
block -2 0 2 base-block paint=body
block -1 0 2 generator-t1
block 0 0 2 gyro-t1
block 1 0 2 fuel-tank-t1
block 2 0 2 base-block paint=body
block -2..-1 0 3 base-block paint=body,body,body,body,hazard,body
block 0 0 3 container-t1
block 1..2 0 3 base-block paint=body,body,body,body,hazard,body
block -1 0 4 thruster-t1
block 1 0 4 thruster-t1
block -2 1 -3 window-block corner rot=+y-x
block -1..1 1 -3 window-block slope
block 2 1 -3 window-block corner
block -2..2 1 3 base-block slope rot=+y+z paint=stripe
