# Hauler: a Big Core in Flight Mode. A space truck: a cab up front behind a raked windscreen, a
# spine running back to the engine housing, and two long cargo pods holding forty containers, as
# much storage as a large structure can have.
#
# Large grid (2 m cells). x is starboard, y up, -z forward. The core sits in the spine.
# Three mains in the housing, retros beside the cab, six lift jets and five legs underneath, side
# jets on the pods, down jets on the roof; three generators, three gyros and a fuel tank in the
# spine.

schema galhack.blueprint
version 1
name "Hauler"
grid large
mode capital
gravity on

# Livery: cream cab, charcoal spine and housing, orange pods with black stripes, hazard ends.
paint hull base=ece3c8 grime=2
paint dark base=2b2d42 grime=2
paint grey base=4d5563 grime=2
paint pod base=e85d04 grime=2
paint stripe base=e85d04 accent=2b2d42 pattern=stripes grime=2
paint hazard base=f4a100 accent=2b2d42 pattern=hazard grime=2
paint teal base=0a9396 grime=1

# --- Cab (z -10..-6): floor, walls, raked windscreen, the seat, a side door ---------------------
block -2..2 0 -10..-6 steel paint=dark
block -2..2 0 -11 hardened slope paint=hazard
block -2 1 -9..-8 steel paint=hull
block -2 1 -7 door
block -2 1 -6 steel paint=hull
block 2 1 -9..-6 steel paint=hull
block -2 1 -10 steel slope paint=hull
block 2 1 -10 steel slope paint=hull
block -1..1 1 -10 glass slope
block 0 1 -8 chair
block -1..1 1 -6 steel paint=grey
block -2..2 2 -9..-6 steel paint=hull
block -2 2 -10 steel slope rot=+y-x paint=hull
block 2 2 -10 steel slope rot=+y+x paint=hull
block -1..1 2 -10 steel slope paint=teal
block 0 1 -7 light rot=+z-y

# --- Spine (x -1..1, y 0..1, z -5..6): the core and the machinery ------------------------------
block -1..1 0 -5..-1 steel paint=dark
block -1 0 0 generator
block 0 0 0 core
block 1 0 0 generator
block -1..1 0 1..6 steel paint=dark
block -1..1 1 -5..-3 steel paint=grey
block -1 1 -2 gyro
block 0 1 -2 fueltank
block 1 1 -2 gyro
block -1..1 1 -1..1 steel paint=grey
block -1 1 2 gyro
block 0 1 2 generator
block 1 1 2 steel paint=grey
block -1..1 1 3..6 steel paint=grey
block -1..1 2 -5..6 steel paint=dark

# --- Cargo pods (x ±2..±3, y 0..2, z -3..6): forty containers, clad and striped -----------------
block -2 0..1 -3..6 container
block 2 0..1 -3..6 container
block -3 0..1 -3..6 steel paint=pod -x=stripe
block 3 0..1 -3..6 steel paint=pod +x=stripe
block -2 2 -3..6 steel paint=pod
block 2 2 -3..6 steel paint=pod
block -3 2 -3..6 steel slope rot=+y-x paint=pod
block 3 2 -3..6 steel slope rot=+y+x paint=pod
block -3..-2 0..2 -4 steel slope paint=hazard
block 2..3 0..2 -4 steel slope paint=hazard
block -3..-2 0..2 7 steel slope rot=+y+z paint=hazard
block 2..3 0..2 7 steel slope rot=+y+z paint=hazard

# --- Engine housing (z 7..8) with three mains, and a dorsal fin --------------------------------
block -1..1 0..2 7..8 steel paint=dark
block -1 0 9 thruster
block 1 0 9 thruster
block 0 1 9 thruster
block 0 0 9 steel paint=hazard
block -1 1 9 steel slope rot=+y+z paint=dark
block 1 1 9 steel slope rot=+y+z paint=dark
block -1..1 2 9 steel slope rot=+y+z paint=dark
block 0 3 5 steel slope paint=teal
block 0 3 6..8 steel paint=teal
block 0 4 7 steel slope paint=teal
block 0 4 8 steel paint=teal

# --- Manoeuvring: retros by the cab, side jets on the pods, down jets on the roof --------------
block -3 0 -8 thruster rot=+y+z
block 3 0 -8 thruster rot=+y+z
block -4 1 1 thruster rot=+y+x
block 4 1 1 thruster rot=+y-x
block -2 3 1 thruster rot=+z-y
block 2 3 1 thruster rot=+z-y

# --- Underneath: six lift jets and five legs ----------------------------------------------------
block 0 -1 -8 thruster rot=+z+y
block -2 -1 -2 thruster rot=+z+y
block 2 -1 -2 thruster rot=+z+y
block -2 -1 5 thruster rot=+z+y
block 2 -1 5 thruster rot=+z+y
block 0 -1 8 thruster rot=+z+y
block 0 -1 -10 gear
block -3 -1 -2 gear
block 3 -1 -2 gear
block -3 -1 5 gear
block 3 -1 5 gear
