# Hauler: a space truck. An iron cab 4 m wide and 3 m clear behind a windscreen, two command
# chairs, a door to port up a step; a spine behind it with the generators, gyros and fuel; two long
# cargo pods holding 52 Container T4s. Four Thruster T3 mains, two retros, four lift jets at the pods'
# corners, two down jets, a side jet each way, four pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Hauler"
grid 1m
mode flight
gravity on

paint cream base=ece3c8 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint spine base=2b2d42 grime=2
paint pod base=e85d04 pattern=stripes grime=1
paint hazard base=f4a100 pattern=hazard grime=2

block -3 -1 -14 iron-plated slope rot=-x-z paint=cream
block -2..1 -1 -14 iron-plated slope rot=-y-z paint=spine
block 2 -1 -14 iron-plated slope rot=+x-z paint=cream
block -3 -1 -13 iron-plated paint=cream
block -2..1 -1 -13 iron-plated paint=cream,cream,deck,cream,cream,cream
