# Dart Fighter: a light fighter. A Cockpit T1 on an iron fuselage, delta wings with winglets at the
# tips, twin tail fins and four gatlings on their leading edges; up the step onto the port wing and along the
# fuselage to the cockpit. Generators, gyro and fuel in the bay behind it, three mains, two retros,
# three lift jets, a down jet, a side jet on each wingtip, three pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Dart Fighter"
grid 1m
mode flight
gravity on

paint hull base=ece3c8 grime=1
paint belly base=2b2d42 grime=2
paint deck base=4a4e57 grime=1
paint chev base=ece3c8 accent=e85d04 pattern=chevrons grime=1
paint red base=c1121f grime=1

block -2 -1 -6 iron-plated corner rot=+y-x paint=belly,belly,chev,belly,belly,belly
block -1 -1 -6 iron-plated paint=belly,belly,chev,belly,belly,belly
block 0 -1 -6 pad-t1
block 1 -1 -6 iron-plated paint=belly,belly,chev,belly,belly,belly
block 2 -1 -6 iron-plated corner paint=belly,belly,chev,belly,belly,belly
