block 1..2 -1 -5 iron-plated paint=belly,belly,chev,belly,belly,belly
block -2..2 -1 -4 iron-plated paint=belly,belly,deck,belly,belly,belly
block -2..2 -1 -3 iron-plated paint=belly,belly,deck,belly,belly,belly
block -2..-1 -1 -2 iron-plated paint=belly,belly,deck,belly,belly,belly
block 0 -1 -2 thruster-t1 rot=+z+y
block 1..2 -1 -2 iron-plated paint=belly,belly,deck,belly,belly,belly
block -3 -1 -1 iron-plated corner rot=+y-x paint=red,red,chev,red,red,red
block -2..2 -1 -1 iron-plated paint=belly,belly,deck,belly,belly,belly
