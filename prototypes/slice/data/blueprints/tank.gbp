# Hover Tank: a Big Core in Hover Mode. A low armoured hull on ten large hover plates, a raked
# hardened glacis, armoured sponsons down both flanks, a driver's cupola, and a turret ring with a
# long barrel over the deck.
#
# Large grid (2 m cells). x is starboard, y up, -z forward. The core sits in the hull.
# Large Hover isn't wired yet: today a Big Core's hover plates lift nothing, so it sits on its
# plates. Two mains in the stern and retros on the sponsons push it once it rides.

schema galhack.blueprint
version 1
name "Hover Tank"
grid large
mode hover
gravity on

# Livery: sand hull, charcoal running gear and barrel, a teal flash, hazard on the stern plate.
paint sand base=c9a66b grime=2
paint dark base=2b2d42 grime=2
paint grey base=4d5563 grime=2
paint flash base=c9a66b accent=0a9396 pattern=chevrons grime=2
paint hazard base=f4a100 accent=2b2d42 pattern=hazard grime=2

# --- Running gear (y -1): ten hover plates, a keel between them --------------------------------
block -3 -1 -3 hover
block 3 -1 -3 hover
block -2 -1 -3 hover
block 2 -1 -3 hover
block -2 -1 0 hover
block 2 -1 0 hover
block -2 -1 3 hover
block 2 -1 3 hover
block -3 -1 3 hover
block 3 -1 3 hover
block -1..1 -1 -3..3 steel paint=dark

# --- Hull (y 0), the core inside; the glacis and the stern ------------------------------------
block -2..2 0 -4..-1 hardened paint=sand
block -2 0 0 hardened paint=sand
block -1 0 0 generator
block 0 0 0 core
block 1 0 0 gyro
block 2 0 0 hardened paint=sand
block -2..2 0 1 hardened paint=sand
block -2..-1 0 2 hardened paint=sand
block 0 0 2 generator
block 1..2 0 2 hardened paint=sand
block -2..-1 0 3 hardened paint=sand
block 0 0 3 gyro
block 1..2 0 3 hardened paint=sand
block -2..2 0 4 hardened paint=sand
block -2..2 0 -5 hardened slope paint=sand

# --- Sponsons (x ±3): armoured flanks, raked at the front, chamfered on top -------------------
block -3 0 -4..4 hardened paint=flash
block 3 0 -4..4 hardened paint=flash
block -3 0 -5 hardened slope paint=sand
block 3 0 -5 hardened slope paint=sand
block -3 1 -4..4 hardened slope rot=+y-x paint=sand
block 3 1 -4..4 hardened slope rot=+y+x paint=sand

# --- Deck (y 1): the glacis carried up, the driver's seat behind a vision slit -------------------
block -2..2 1 -4 hardened slope paint=sand
block -2 1 -3..4 steel paint=sand
block -1 1 -3 glass slope
block -1 1 -2 chair
block 0..2 1 -3..4 steel paint=sand
block -1 1 -1..4 steel paint=sand

# --- Turret (y 2): a ring three by three, bevelled, the gun on top, a long barrel forward ------
block -1..1 2 0..2 hardened paint=grey
block -1..1 2 -1 hardened slope paint=grey
block -1..1 2 3 hardened slope rot=+y+z paint=grey
block 0 3 1 turret
block 0 3 0 hardened paint=grey
block 0 3 -4..-1 steel cylinder rot=+z-y paint=dark

# --- Stern: two mains in an engine plate; retros on the sponson fronts -------------------------
block -2..2 0 5 steel paint=hazard
block -1 0 6 thruster
block 1 0 6 thruster
block -4 0 -3 thruster rot=+y+z
block 4 0 -3 thruster rot=+y+z
block -2 1 5 steel slope rot=+y+z paint=sand
block 2 1 5 steel slope rot=+y+z paint=sand
block -1..1 1 5 steel paint=dark
