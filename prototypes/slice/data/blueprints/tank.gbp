# Hover Tank: a low iron hull on eight Hover plate T1s, a hardened glacis and armoured
# sponsons. Up the stair at the stern onto the deck: the driver's Cockpit T1 forward, the turret
# behind it. Generator, gyro, fuel and a locker in the hull; two mains at the stern and a retro on
# each sponson.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Hover Tank"
grid 1m
mode hover
gravity on

paint sand base=c8b48a grime=2
paint belly base=2b2d42 grime=2
paint deck base=4a4e57 grime=1
paint flash base=c8b48a accent=0a9396 pattern=stripes grime=2
paint hazard base=f4a100 pattern=hazard grime=2

block -4 -1 -8 hardened-plated slope rot=-x-z paint=sand
block -3..3 -1 -8 hardened-plated paint=sand
block 4 -1 -8 hardened-plated slope rot=+x-z paint=sand
block -4..4 -1 -7 iron-plated paint=sand,sand,sand,belly,sand,sand
block -5 -1 -6 hardened-plated paint=flash
block -4 -1 -6 hover-t1
block -3..3 -1 -6 iron-plated paint=sand,sand,sand,belly,sand,sand
block 4 -1 -6 hover-t1
block 5 -1 -6 hardened-plated paint=flash
block -5 -1 -5 hardened-plated paint=flash
