# Outpost: a first base on the ground. A concrete hall 10 x 9 m and 4 m floor to ceiling under a raked
# roof, a glazed clerestory rising out of its middle; power, fuel, a fabricator and four lockers along
# the north wall. A door west into a 3 m ops wing with the command chair at its window; a double door
# south under a porch, up two steps; a door east onto a landing pad 12 m square level with the floor,
# its rim hazard-marked and ramped down to the ground.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Outpost"
grid 1m
mode base
gravity on

paint wall base=e9dfc4 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint band base=0a9396 grime=1
paint roof base=3a3f47 grime=2
paint hazard base=f4a100 pattern=hazard grime=2
paint pad base=5a5e66 grime=2
paint frame base=2b2d42 grime=1

