block -1..1 4 -2 iron-plated slope paint=hull
block 2 4 -2 iron-plated slope rot=+x-z paint=hull
block -2 4 -1 iron-plated paint=hull
block -1..1 4 -1 iron-plated paint=hull,hull,hull,inner,hull,hull
block 2 4 -1 iron-plated paint=hull
