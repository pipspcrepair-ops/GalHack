# Escape pod: a crash-landed capsule kept as a shelter. An iron shell 3 x 4 m inside and
# 3 m tall, a door at the front up one step, a command chair facing it, a locker, a generator and its
# fuel along the back wall, a light, and a scorched heat shield underneath.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Escape Pod"
grid 1m
mode base
gravity on

paint hull base=e85d04 grime=2
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint shield base=2b2d42 grime=3
paint band base=ece3c8 grime=1

block 0 0 -3 stairs paint=hull
block -2 0 -2 iron-plated slope rot=-x-z paint=hull,hull,hull,shield,hull,hull
block -1..1 0 -2 iron-plated paint=hull,hull,hull,shield,hull,hull
block 2 0 -2 iron-plated slope rot=+x-z paint=hull,hull,hull,shield,hull,hull
block -2 0 -1 iron-plated paint=hull,hull,hull,shield,hull,hull
block -1..1 0 -1 iron-plated paint=hull,hull,deck,shield,hull,hull
block 2 0 -1 iron-plated paint=hull,hull,hull,shield,hull,hull
block -2 0 0 iron-plated paint=hull,hull,hull,shield,hull,hull
block -1 0 0 iron-plated paint=hull,hull,deck,shield,hull,hull
block 0 0 0 core
block 1 0 0 iron-plated paint=hull,hull,deck,shield,hull,hull
block 2 0 0 iron-plated paint=hull,hull,hull,shield,hull,hull
block -2 0 1 iron-plated paint=hull,hull,hull,shield,hull,hull
block -1..1 0 1 iron-plated paint=hull,hull,deck,shield,hull,hull
block 2 0 1 iron-plated paint=hull,hull,hull,shield,hull,hull
block -2 0 2 iron-plated paint=hull,hull,hull,shield,hull,hull
block -1..1 0 2 iron-plated paint=hull,hull,deck,shield,hull,hull
block 2 0 2 iron-plated paint=hull,hull,hull,shield,hull,hull
block -2 0 3 iron-plated slope rot=-x+z paint=hull,hull,hull,shield,hull,hull
block -1..1 0 3 iron-plated paint=hull,hull,hull,shield,hull,hull
block 2 0 3 iron-plated slope rot=+x+z paint=hull,hull,hull,shield,hull,hull
block -2 1 -2 iron-plated slope rot=-x-z paint=hull
block -1 1 -2 iron-plated paint=hull,hull,hull,hull,inner,hull
block 0 1 -2 door-1x2x1
block 1 1 -2 iron-plated paint=hull,hull,hull,hull,inner,hull
block 2 1 -2 iron-plated slope rot=+x-z paint=hull
block -2 1 -1 iron-plated paint=inner,hull,hull,hull,hull,hull
block 1 1 -1 command-chair
block 2 1 -1 iron-plated paint=hull,inner,hull,hull,hull,hull
block -2 1 0 iron-plated paint=inner,hull,hull,hull,hull,hull
block 2 1 0 iron-plated paint=hull,inner,hull,hull,hull,hull
block -2 1 1 iron-plated paint=inner,hull,hull,hull,hull,hull
block 2 1 1 iron-plated paint=hull,inner,hull,hull,hull,hull
block -2 1 2 iron-plated paint=inner,hull,hull,hull,hull,hull
block -1 1 2 container-t1
block 0 1 2 generator-t1
block 1 1 2 fuel-tank-t1
block 2 1 2 iron-plated paint=hull,inner,hull,hull,hull,hull
block -2 1 3 iron-plated slope rot=-x+z paint=hull
block -1..1 1 3 iron-plated paint=hull,hull,hull,hull,hull,inner
block 2 1 3 iron-plated slope rot=+x+z paint=hull
block -2 2 -2 iron-plated slope rot=-x-z paint=band
block -1 2 -2 iron-plated paint=band,band,hull,hull,band,band
block 1 2 -2 iron-plated paint=band,band,hull,hull,band,band
