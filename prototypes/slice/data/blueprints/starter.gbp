# Skiff: the slice's starter vessel and the cheapest flyer in the game: an open-cockpit
# hopper of plain base blocks, painted. A command chair behind a clear windscreen, a cockpit tub you
# step into from the port step, an engine hump behind with the generator, gyro and fuel,
# two mains, a retro, a side jet each way, a lift jet, a down jet and three pads.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Skiff"
grid 1m
mode flight
gravity on

paint hull base=ece3c8 grime=1
paint belly base=2b2d42 grime=2
paint deck base=4a4e57 grime=1
paint stripe base=ece3c8 accent=e85d04 pattern=stripes grime=1
paint chev base=0a9396 accent=f4a100 pattern=chevrons grime=1
paint hazard base=f4a100 pattern=hazard grime=2

block 0 -1 -6 thruster-t1 rot=+y+z
block -2 -1 -5 base-block slope rot=-x-z paint=belly
block -1..1 -1 -5 base-block paint=belly
block 2 -1 -5 base-block slope rot=+x-z paint=belly
block -2..-1 -1 -4 base-block paint=belly
block 0 -1 -4 pad-t1
block 1..2 -1 -4 base-block paint=belly
block -2 -1 -3 base-block paint=belly
block -1 -1 -3 base-block paint=belly,belly,deck,belly,belly,belly
block 1 -1 -3 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 -3 base-block paint=belly
block -2 -1 -2 base-block paint=belly
block -1..1 -1 -2 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 -2 base-block paint=belly
block -2 -1 -1 base-block paint=belly
block -1..1 -1 -1 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 -1 base-block paint=belly
block -3 -1 0 stairs rot=+y-x paint=hull
block -2..1 -1 0 base-block paint=belly,belly,deck,belly,belly,belly
block 2 -1 0 base-block paint=belly
block -2..-1 -1 1 base-block paint=belly
block 0 -1 1 thruster-t1 rot=+z+y
block 1 -1 1 core
block 2 -1 1 base-block paint=belly
block -2 -1 2 pad-t1
block -1..1 -1 2 base-block paint=belly
block 2 -1 2 pad-t1
block -1..1 -1 3 base-block paint=belly
block -2 0 -5 base-block slope rot=-x-z paint=hull
block -1..1 0 -5 base-block slope paint=hull
block 2 0 -5 base-block slope rot=+x-z paint=hull
block -2..2 0 -4 base-block paint=hull
block -2 0 -3 base-block paint=stripe
block 0 0 -3 command-chair
block 2 0 -3 base-block paint=stripe
block -2 0 -2 base-block paint=stripe
block 2 0 -2 base-block paint=stripe
block -2 0 -1 base-block paint=stripe
block 2 0 -1 base-block paint=stripe
block 2 0 0 base-block paint=stripe
block -2..2 0 1 base-block paint=chev
block -3 0 2 thruster-t1 rot=+y+x
block -2 0 2 base-block paint=chev
block -1 0 2 generator-t1
block 0 0 2 gyro-t1
block 1 0 2 fuel-tank-t1
block 2 0 2 base-block paint=chev
block 3 0 2 thruster-t1 rot=+y-x
block -2..2 0 3 base-block paint=chev,chev,chev,chev,hazard,chev
block -1 0 4 thruster-t1
block 1 0 4 thruster-t1
block -1..1 1 -4 window-block slope
block -2..2 1 1 base-block slope paint=chev
block 0 1 2 thruster-t1 rot=+z-y
