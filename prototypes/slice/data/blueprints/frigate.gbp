# Frigate: a small capital ship in iron. Forward, a bow that tapers to a glazed prow over two decks
# 4 m floor to ceiling joined by a 3 m stair: the machine room below (generators, fuel, gyros,
# lockers) and the bridge above, two command chairs behind the brow. Aft, a hangar 10 m wide, 6 m
# clear and 16 m deep, open at the stern, that takes the Skiff; a double door from it into the
# machine room, a step up at its mouth. Rounded engine nacelles down both flanks; Thruster T3s throughout.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Frigate"
grid 1m
mode flight
gravity on

paint hull base=c9ccd1 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint keel base=2b2d42 grime=2
paint red base=c1121f grime=1
paint hazard base=f4a100 pattern=hazard grime=2
paint roof base=6b7280 grime=2

block -4 0 -20 iron-plated slope rot=-x-z paint=hull,hull,hull,keel,hull,hull
block -3..2 0 -20 iron-plated slope rot=-y-z paint=keel
block 3 0 -20 iron-plated slope rot=+x-z paint=hull,hull,hull,keel,hull,hull
