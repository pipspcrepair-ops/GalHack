# Shuttle: a Small Core in Flight Mode. A boxy people-and-cargo runner: two seats side by side
# behind a tall raked windscreen, cargo racks down both walls, an open hatchway at the back, and
# an engine pod on each flank.
#
# Small grid (0.5 m cells). x is starboard, y up, -z forward. The core sits in the floor.
# Four mains in the pods, retros beside the nose, six lift jets under the belly and the pods, a
# down jet on the roof hump, a side jet on each pod; two generators and a gyro in the belly;
# sixteen containers; a nose leg and two main legs.

schema galhack.blueprint
version 1
name "Shuttle"
grid small
mode vessel
gravity on

# Livery: cream hull, charcoal belly, a teal band round the cabin, orange pods, hazard at the hatch.
paint hull base=ece3c8 grime=1
paint belly base=2b2d42 grime=2
paint band base=0a9396 accent=ece3c8 pattern=stripes grime=1
paint pod base=e85d04 accent=2b2d42 pattern=chevrons grime=1
paint orange base=e85d04 grime=1
paint dark base=3a3f47 grime=1
paint hazard base=f4a100 accent=2b2d42 pattern=hazard grime=2

# --- Belly (y -1): generators and a gyro inside, chamfered sides and chin ---------------------
block -2..2 -1 -7..1 steel paint=belly
block -2 -1 2 steel paint=belly
block -1 -1 2 generator
block 0 -1 2 gyro
block 1 -1 2 generator
block 2 -1 2 steel paint=belly
block -2..2 -1 3..6 steel paint=belly
block -3 -1 -7..6 steel slope rot=-y-x paint=belly
block 3 -1 -7..6 steel slope rot=-y+x paint=belly
block -2..2 -1 -8 steel slope rot=-y-z paint=belly

# --- Floor (y 0), the core in the middle, a hardened chin ---------------------------------------
block -3..3 0 -8..-1 steel paint=dark
block -3..-1 0 0 steel paint=dark
block 0 0 0 core
block 1..3 0 0 steel paint=dark
block -3..3 0 1..6 steel paint=dark
block -3..3 0 -9 hardened slope paint=orange

# --- Walls (x ±3): a teal band at y 2, windows behind the cockpit, pillars raking with the screen
block -3 1 -8..5 steel paint=hull
block 3 1 -8..5 steel paint=hull
block -3 2 -8 steel slope paint=hull
block 3 2 -8 steel slope paint=hull
block -3 2 -7..5 steel paint=band
block 3 2 -7..5 steel paint=band
block -3 3 -7 steel slope paint=hull
block 3 3 -7 steel slope paint=hull
block -3 3 -6..-5 steel paint=hull
block 3 3 -6..-5 steel paint=hull
block -3 3 -4..-3 glass
block 3 3 -4..-3 glass
block -3 3 -2..5 steel paint=hull
block 3 3 -2..5 steel paint=hull
block -3 4 -6 steel slope paint=hull
block 3 4 -6 steel slope paint=hull
block -3 4 -5..5 steel paint=hull
block 3 4 -5..5 steel paint=hull

# --- Cockpit: the dash, the raked windscreen, two seats ----------------------------------------
block -2..2 1 -8..-7 steel paint=dark
block -2..2 2 -8 glass slope
block -2..2 3 -7 glass slope
block -2..2 4 -6 glass slope
block -1 1 -5 chair
block 1 1 -5 chair

# --- Cargo: racks of containers down both walls, two high ---------------------------------------
block -2 1..2 1..4 container
block 2 1..2 1..4 container

# --- Roof (y 5) with bevelled edges and a sensor hump --------------------------------------------
block -2..2 5 -5..6 steel paint=hull
block -3 5 -5..6 steel slope rot=+y-x paint=hull
block 3 5 -5..6 steel slope rot=+y+x paint=hull
block -1..1 6 -2 steel slope paint=dark
block -1..1 6 -1..2 steel paint=dark
block -1..1 6 3 steel slope rot=+y+z paint=dark
block 0 4 -3 light rot=+z-y
block 0 4 2 light rot=+z-y

# --- Back wall (z 6) round an open hatchway three wide and four high ----------------------------
block -3 1..4 6 steel paint=hull
block -2 1..4 6 steel paint=hazard
block 2 1..4 6 steel paint=hazard
block -3..3 5 7 steel slope rot=+y+z paint=hull

# --- Engine pods on the flanks, two mains in each ------------------------------------------------
block -4 1..2 1 steel slope paint=orange
block 4 1..2 1 steel slope paint=orange
block -4 1..2 2..6 steel paint=pod
block 4 1..2 2..6 steel paint=pod
block -4 1 7 thruster
block -4 2 7 thruster
block 4 1 7 thruster
block 4 2 7 thruster

# --- Manoeuvring: retros by the nose, side jets on the pods, a down jet on the hump --------------
block -4 1 -7 thruster rot=+y+z
block 4 1 -7 thruster rot=+y+z
block -5 1 4 thruster rot=+y+x
block 5 1 4 thruster rot=+y-x
block 0 7 0 thruster rot=+z-y

# --- Under it: six lift jets and three legs -------------------------------------------------------
block -1 -2 -5 thruster rot=+z+y
block 1 -2 -5 thruster rot=+z+y
block -1 -2 3 thruster rot=+z+y
block 1 -2 3 thruster rot=+z+y
block -4 0 4 thruster rot=+z+y
block 4 0 4 thruster rot=+z+y
block 0 -2 -6 gear
block -2 -2 4 gear
block 2 -2 4 gear
