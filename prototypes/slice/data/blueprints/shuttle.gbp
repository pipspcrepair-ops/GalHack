# Shuttle: a boxy people-and-cargo runner. An iron cabin 4 m wide, 3 m floor to ceiling and
# 11 m long: two command chairs side by side behind the windscreen, eight lockers down the walls
# either side of a 2 m aisle, a double hatch at the back up a step. An engine pod on a pylon on each
# flank holds a generator and fuel (and the gyro to port); four mains in the pods, two retros, two
# side jets, four lift jets, a down jet.
# Written by slice/tests/BlueprintSet.cs (Designer); regenerate rather than edit.
# GalHack blueprint. One statement per line; '#' starts a comment.
# block <x> <y> <z> <type> [shape] [rot=<up><forward>] [paint=<name> | paint=<+x>,<-x>,<+y>,<-y>,<+z>,<-z>] [hp=<n>] [open] [off] [light=<rrggbb[+rrggbb]>:<mode>:<hz>:<seed>]
# Cells: x right, y up, -z forward; a..b is an inclusive range. rot defaults to +y-z; '-' is bare metal.
schema galhack.blueprint
version 1
name "Shuttle"
grid 1m
mode flight
gravity on

paint hull base=ece3c8 grime=1
paint inner base=d8d2c2
paint deck base=4a4e57 grime=1
paint band base=0a9396 grime=1
paint pod base=e85d04 grime=1
paint hazard base=f4a100 pattern=hazard grime=2

block -3 -1 -6 iron-plated slope rot=-x-z paint=hull
block -2..1 -1 -6 iron-plated slope rot=-y-z paint=hull
block 2 -1 -6 iron-plated slope rot=+x-z paint=hull
block -3 -1 -5 pad-t1
block -2..1 -1 -5 iron-plated paint=hull,hull,deck,hull,hull,hull
block 2 -1 -5 pad-t1
