// The slice's own numbers. Everything else is read from the prototype that owns it.
{
  "planet": {
    // The starter world: a temperate planet from the planet generator.
    "seed": 7,
    "archetype": "Temperate",
    "variant": 0,
    "gravity": 9.8,
    // Top of the atmosphere, m: no weight above it (the handling model's switch). Above the
    // highest mountains any planet makes.
    "ceiling": 4000,
    // The pod comes down at dawn (0 midnight, 0.5 noon).
    "startTimeOfDay": 0.255,
    "podDropHeight": 260,
    "podDropSeconds": 7
  },

  // What gathering gives, in shared/Items' raw items. An ore cell gives its deposit's ore
  // (shared/Items' reference rate, oreUnitsPerCell); a rock cell gives stone; cutting a plant
  // gives organics (kg, for the replicator) and biomass.
  "materials": {
    "stonePerRockCell": 2,
    "organicsPerPlant": 1.5,
    "biomassPerPlant": 2,
    // The escape pod's locker: enough parts for the Skiff's core and seat, so its blueprint can be
    // set down at once. Everything else is made from ore by the pod's own small constructor.
    "podLocker": { "hull-plate": 8, "circuit-board": 4, "winding": 2, "glass": 2, "polymer": 1 }
  },

  // The planet's climate as the suit feels it: the generator's temperature field (0 frozen to
  // 1 scorching) spread over this range, warmer by day, colder with height.
  "climate": {
    "coldestC": -45,
    "hottestC": 65,
    "dayNightSwing": 7,
    "lapsePerKm": 6.5,
    // Ambient oxygen, %, by the sky's air.
    "oxygenByAir": { "Thin": 9, "Breathable": 21, "Humid": 21, "Dusty": 18, "Ash": 13, "Sulfurous": 6, "Exotic": 11 },
    // Background radiation, RAD (the visor warns above 3).
    "radiationByArchetype": { "Temperate": 0, "Arid": 0.5, "Ice": 0.2, "Lava": 1.5, "Alien": 2 },
    // A cockpit seat with its canopy shut is a sealed, heated volume.
    "cockpitC": 20
  },

  "tool": {
    "reach": 7.5,
    "digRadius": 1.42,
    "digInterval": 0.18,
    "cutReach": 4,
    "shotDamage": 18,
    "shotInterval": 0.22,
    "shotRange": 120
  },

  "build": {
    "reach": 9,
    // Holding the button on a blueprint places its blocks one at a time, in order, at this rate.
    "blueprintPlacesPerSecond": 8,
    "starterBlueprint": "starter.gbp"
  },

  "wildlife": {
    // Creatures live on a square of the planet around the landing site, this far each way, m.
    "patchHalfSize": 300,
    // Nothing spawns this close to the pod.
    "safeRadius": 60,
    "alienness": 0.25
  }
}
