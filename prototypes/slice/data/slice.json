// The slice's own numbers. Everything else is read from the prototype that owns it.
{
  "planet": {
    // The world: every new game rolls a fresh seed and the player picks the planet type on the
    // start screen (Game.World, WorldChoice); tests and screenshots pin both (-- --seed N --planet type).
    "gravity": 9.8,
    // Top of the atmosphere, m: no weight above it (the handling model's switch). Above the
    // highest mountains any planet makes.
    "ceiling": 4000,
    // You wake at dawn (0 midnight, 0.5 noon).
    "startTimeOfDay": 0.255,
    // The valley fog's density against planet-surface's own: thinner, so the first view reads.
    "valleyFogScale": 0.4
  },

  // What gathering gives, as shared/Items' raw items (an ore cell gives the ore its deposit kind
  // maps to in items.json).
  "materials": {
    // Raw ore per 1 m cell of ore dug, whatever the tool (a better tool digs faster, never more a cell).
    // Was 12 (36 kg a cell): a bag held tons in minutes. At 3, the first tools' and the hover bike's
    // 30 iron ore is ten cells of a deposit, a minute or two from the start with the walk.
    "orePerCell": 3,
    // Stone per cell of rock dug (soil gives nothing).
    "stonePerRockCell": 1,
    // Cutting a plant, at scale 1: biomass, and kg of organics for the replicator.
    "biomassPerPlant": 2,
    "organicsPerPlant": 1.5,
    // The starting kit in the bunker's locker: a few days' food and air, not a ship.
    "startKit": { "trail-ration": 4, "patch-kit": 2, "air-cell": 2, "biomass": 6 },
    // What the castaway has on the toolbar from the start, slot 1 first: nothing. They wake
    // empty-handed and make the survival tool, free, in the suit fabricator.
    "toolbar": [ ]
  },

  // The planet's climate as the suit feels it: the generator's temperature field (0 frozen to
  // 1 scorching) spread over this range, warmer by day, colder with height.
  "climate": {
    "coldestC": -45,
    "hottestC": 65,
    "dayNightSwing": 7,
    "lapsePerKm": 6.5,
    // Ambient oxygen, %, by the sky's air.
    "oxygenByAir": { "Thin": 9, "Breathable": 21, "Humid": 21, "Dusty": 18, "Ash": 13, "Sulfurous": 6, "Exotic": 11 },
    // Background radiation, RAD (the visor warns above 3).
    "radiationByArchetype": { "Temperate": 0, "Arid": 0.5, "Ice": 0.2, "Lava": 1.5, "Alien": 2 },
    // A sealed room aboard a powered structure, or the cryo bunker, is heated and has air; a command chair on its own has neither.
    "sealedRoomC": 20,
    // A sealed room's air: with its structure powered it eases to sealedRoomC (the gap shrinks by e every roomEaseSeconds,
    // comfortable within about a minute from -45 or 65 °C); power off, it holds roomHoldSeconds, then drifts to the
    // outside's temperature and oxygen (the gap by e every roomDriftSeconds).
    "roomEaseSeconds": 30,
    "roomHoldSeconds": 120,
    "roomDriftSeconds": 180,
    // A shut room in a place takes placeShelter of the way from the outside's temperature to sealedRoomC (its air is the
    // outside's), easing there by e every placeEaseSeconds. A climate node inside still holds its band.
    "placeShelter": 0.5,
    "placeEaseSeconds": 60,
    // Out in the weather: from stormWarnFrom of its exposure (weather.json) the visor warns, from
    // stormHarmFrom health drains at stormHealthPerSecond x exposure. Only a blizzard or a fire storm
    // reaches that (about 5 health a second). Any shelter or cover stops it at once.
    "stormWarnFrom": 0.5,
    "stormHarmFrom": 1,
    "stormHealthPerSecond": 3,
    // In water at or below iceWaterC the visor warns at once and, iceWaterWarnSeconds later, health drains.
    "iceWaterC": 2,
    "iceWaterHealthPerSecond": 7,
    "iceWaterWarnSeconds": 1.5
  },

  "tool": {
    "reach": 7.5,
    "digRadius": 1.42,
    "digInterval": 0.18,
    "cutReach": 4,
    "shotDamage": 18,
    "shotInterval": 0.22,
    "shotRange": 120,
    // Gathering chips: each pulse of the beam does rate x interval damage to the cell or plant under
    // it (less to the cells around it), and resources trickle in as it goes. A cell, plant or tree
    // is gone when its durability is worked through. Ground is held a cell at a time (the terrain
    // store has no partial density), so it sinks in cell-sized stages, the beam's ball of cells
    // wearing down from the centre out.
    "gatherRate": 3,
    "durability": { "soil": 1, "rock": 2, "deepRock": 3, "ore": 3, "plant": 1.5, "tree": 9, "boulder": 5, "treeYield": 1.5, "boulderStone": 3 },
    // The hand tools: each a faster survival tool (the tech tree unlocks them by level).
    "tiers": {
      "survival-tool": { "name": "Survival tool", "rate": 1, "radius": 1.42, "shot": 1 },
      "mining-drill":  { "name": "Mining drill",  "rate": 2.5, "radius": 1.6, "shot": 1.4 },
      "plasma-drill":  { "name": "Plasma drill",  "rate": 5,   "radius": 1.9, "shot": 2 }
    }
  },

  "build": {
    "reach": 9,
    // Holding the button on a blueprint places its blocks one at a time, in order, at this rate.
    "blueprintPlacesPerSecond": 8,
    "starterBlueprint": "starter.gbp",
    // The BLUEPRINTS tab's starter set, in data/blueprints.
    "library": ["starter.gbp", "rover.gbp", "dart.gbp", "shuttle.gbp", "outpost.gbp", "tank.gbp", "hauler.gbp", "frigate.gbp"],
    // Blueprints the player saves, shown under Yours.
    "saved": "user://blueprints",
    // A structure's area: its blocks' bounding box grown by one margin plus a share of half its
    // longest side (so a big base reaches further: 12 + 0.9 x 20 gives a 40 m base 30 m). Inside it you are
    // linked to its one shared storage (its toolbar, the CORE tab, its containers and
    // constructors); outside, only your own bag counts. Empyrion links you while you stand on a
    // structure, or within 100 m of a wireless block; GalHack's margin stands in for both.
    "area": { "margin": 12, "sizeShare": 0.9 }
  },

  // The climate node: burning, it holds the air within radius metres inside lowC to highC. Each
  // fuel in its hopper burns for so many seconds, the first found in this order.
  "climateNode": { "radius": 9, "lowC": 12, "highC": 26, "fuels": { "energy-cell": 300, "biofuel": 200, "biomass": 60 } },

  // The head torch (L): a cone from the helmet.
  "torch": { "range": 60, "angle": 32, "energy": 6.5, "attenuation": 0.85 },

  // Containers in the world, slots across and down (Empyrion's loot container is 8 x 8).
  "containers": { "corpse": [4, 4], "backpack": [8, 8], "drop": [8, 8] },

  "wildlife": {
    // Creatures live on a square of the planet around the landing site, this far each way, m.
    "patchHalfSize": 300,
    // Nothing spawns this close to the pod.
    "safeRadius": 60,
    "alienness": 0.25,
    // Server setting: block-breaking creatures (rams, burrowers, corroders, siege beasts) may damage
    // players' bases. false keeps bases whole; anything else still takes their blows.
    "breakBases": true,
    // The most wild creatures a patch holds on the most livable world (alive, not crowded).
    "mostPerPatch": 70,
    // Groups of each species a patch holds on the most livable world, against its natural number (giants 1, the rest 2).
    "density": 1.0,
    // How far the world's layers (dead, barren, rich) move its numbers, 0..1: most of the way, so a dead world is plainly quiet
    // and a living one alive (what's left on a dead one is its own: scavengers, its fall's kinds, vermin).
    "layerWeight": 0.8,
    // Topping up as you go: once you have moved on, groups come back out of sight while fewer than this share of the patch's most live within 250 m of you.
    "nearShare": 0.6,
    // How much life a world of each archetype carries: lush worlds busiest, lava all but dead.
    "livable": { "Temperate": 1.0, "Alien": 0.6, "Arid": 0.35, "Ice": 0.3, "Lava": 0.08 },
    "cratered": 0.7
  }
}
