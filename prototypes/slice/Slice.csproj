<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Slice</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Terrain streaming, structure meshing and creature rigs are tight numeric loops; the
         editor's Debug build would run them several times slower. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!--
    The slice is glue. Everything it plays is compiled in from where it lives, never copied:
    shared modules first, then each prototype's engine-free core, then the few engine pieces it
    reuses unchanged (the planet's streamer and sky, building's mesher, the UI theme).
  -->
  <ItemGroup>
    <!-- Shared modules. -->
    <Compile Include="..\..\shared\Physics\**\*.cs" />
    <Compile Include="..\..\shared\Terrain\**\*.cs" />
    <Compile Include="..\..\shared\Galaxy\**\*.cs" />
    <Compile Include="..\..\shared\Music\Core\**\*.cs" />
    <Compile Include="..\..\shared\Items\Core\**\*.cs" />
    <Compile Include="..\..\shared\Items\Production\**\*.cs" />
    <Compile Include="..\..\shared\Items\Bridge\**\*.cs" />
    <!-- Weapons as data and their parts: engine-free, so enemies can fire the same rows. -->
    <Compile Include="..\..\shared\Arms\Core\**\*.cs" />
    <!-- The bestiary: everything that moves. -->
    <Compile Include="..\..\shared\Bestiary\**\*.cs" />
    <!-- The backstop that ends a run which was told to quit and did not. -->
    <Compile Include="..\..\shared\Testing\**\*.cs" />

    <!-- Pure cores. -->
    <Compile Include="..\terrain-digging\src\Terrain\**\*.cs" />
    <Compile Include="..\planet-generator\src\Gen\**\*.cs" />
    <Compile Include="..\planet-generator\src\Look\**\*.cs" />
    <Compile Include="..\planet-generator\src\Surface\FloraMeshes.cs" />
    <Compile Include="..\weather\src\Model\**\*.cs" />
    <Compile Include="..\weather\src\Forces\**\*.cs" />
    <Compile Include="..\weather\src\Glue.cs" />
    <Compile Include="..\poi-generator\src\Gen\**\*.cs" />
    <Compile Include="..\ship-handling\src\Handling\**\*.cs" />
    <Compile Include="..\building\src\Structures\**\*.cs" />
    <!-- Lifting a half-buried hull free (a claimed crash hulk): capital-base's cut planner and lift-off, unchanged. -->
    <Compile Include="..\capital-base\src\Core\CutFree.cs" />
    <Compile Include="..\capital-base\src\Core\CapitalRules.cs" />
    <Compile Include="..\capital-base\src\Core\Cargo.cs" />
    <Compile Include="..\capital-base\src\World\LiftOff.cs" />
    <Compile Include="..\survival-vitals\src\Model\**\*.cs" />
    <Compile Include="..\diegetic-ui\src\Logic\FocusMachine.cs" />
    <Compile Include="..\diegetic-ui\src\Logic\Items.cs" />
    <!-- Phase 2: saves' persistence core (the zone ledger's commits). -->
    <Compile Include="..\saves\src\Persistence\**\*.cs" />

    <!-- The physics sandbox's bridges: a structure as a vessel, the handling model as flight
         rules, weather onto the force path. -->
    <Compile Include="..\physics-sandbox\src\Bridges\HandlingBridge.cs" />
    <Compile Include="..\physics-sandbox\src\Bridges\StructureBridge.cs" />
    <Compile Include="..\physics-sandbox\src\Bridges\WeatherBridge.cs" />

    <!-- Engine pieces reused unchanged: the planet's terrain streaming, sky and weather effects,
         building's structure mesher and ghosts, the creatures' view, the diegetic UI's theme and
         in-world screens. Their shaders and fonts are mounted at the paths they expect (src/Boot). -->
    <Compile Include="..\planet-surface\src\Terrain\**\*.cs" />
    <!-- Phase 2: the generator's globe, space sky and ring shaders (the orbit's globe is drawn as its OrbitView draws it). -->
    <Compile Include="..\planet-generator\src\Shaders.cs" />
    <Compile Include="..\planet-surface\src\Sky\**\*.cs" />
    <Compile Include="..\planet-surface\src\World\**\*.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiSiting.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiSiting.Plan.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiLayer.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiLayerDeco.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiLayer.Tiers.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiLayer.StandIn.cs" />
    <Compile Include="..\planet-surface\src\Poi\PoiLitFaces.cs" />
    <Compile Include="..\planet-surface\src\Infra\**\*.cs" />
    <Compile Include="..\..\shared\Deco\**\*.cs" />
    <Compile Include="..\..\shared\Flora\**\*.cs" />
    <Compile Include="..\poi-generator\src\View\MeshBuild.cs" />
    <Compile Include="..\planet-surface\src\Fx\**\*.cs" />
    <Compile Include="..\planet-surface\src\WeatherView\IWeatherScene.cs" />
    <Compile Include="..\planet-surface\src\WeatherView\LightningFx.cs" />
    <Compile Include="..\planet-surface\src\WeatherView\TornadoFx.cs" />
    <Compile Include="..\building\src\Presentation\ChunkMesher.cs" />
    <Compile Include="..\building\src\Presentation\BlockMaterials.cs" />
    <Compile Include="..\building\src\Presentation\DamageFx.cs" />
    <Compile Include="..\building\src\Presentation\GhostPreview.cs" />
    <Compile Include="..\diegetic-ui\src\Theme\**\*.cs" />
    <Compile Include="..\diegetic-ui\src\Screens\**\*.cs" />
    <!-- Sounds, synthesised in code where they live: building's block clunks and UI clicks, the diegetic UI's chirp. -->
    <Compile Include="..\building\src\Game\Sfx.cs" />
    <Compile Include="..\diegetic-ui\src\World\Sfx.cs" />

    <!-- Test helpers, used where they live: planet-surface's per-frame timing probe. -->
    <Compile Include="..\planet-surface\tests\FrameProbe.cs" />
    <Compile Include="..\building\tests\OcclusionCheck.cs" />
  </ItemGroup>
</Project>
